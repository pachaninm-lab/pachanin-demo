{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pachanin.example/schemas/agricultural-government-systems.registry.schema.v1.json",
  "title": "PC-CROP-10A agricultural government systems registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "registryVersion",
    "generatedAt",
    "evidenceCutoff",
    "operationalStatus",
    "productionHosting",
    "policies",
    "inventoryAuthorities",
    "systems",
    "coverage",
    "forbiddenClaims"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./agricultural-government-systems.registry.schema.v1.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "pc-crop.agricultural-government-systems.registry.v1"
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceCutoff": {
      "type": "string",
      "format": "date"
    },
    "operationalStatus": {
      "type": "string",
      "const": "NOT_ATTESTED"
    },
    "productionHosting": {
      "type": "string",
      "const": "REG_RU_VPS_ONLY"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "inventoryAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inventoryAuthority"
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicUiProviders",
        "integrationSdkAdapters"
      ],
      "properties": {
        "publicUiProviders": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "integrationSdkAdapters": {
          "type": "array",
          "minItems": 15,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        }
      }
    },
    "forbiddenClaims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "$defs": {
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultIntegrationStatus",
        "defaultPlatformState",
        "credentialMaterialStored",
        "credentialReferencesOnly",
        "tenantIsolationAssessment",
        "tenantIsolationRequirement",
        "publicRegistryRule",
        "writeEnablementRule"
      ],
      "properties": {
        "defaultIntegrationStatus": {
          "type": "string",
          "const": "NOT_ASSESSED"
        },
        "defaultPlatformState": {
          "type": "string",
          "const": "DISABLED"
        },
        "credentialMaterialStored": {
          "type": "boolean",
          "const": false
        },
        "credentialReferencesOnly": {
          "type": "boolean",
          "const": true
        },
        "tenantIsolationAssessment": {
          "type": "string",
          "const": "NOT_ASSESSED"
        },
        "tenantIsolationRequirement": {
          "type": "string",
          "const": "SERVER_DERIVED_RBAC_RLS_REQUIRED_BEFORE_ENABLEMENT"
        },
        "publicRegistryRule": {
          "type": "string",
          "const": "OFFICIAL_LOCATOR_AND_FRESH_VERIFICATION_REQUIRED"
        },
        "writeEnablementRule": {
          "type": "string",
          "const": "OFFICIAL_CONTRACT_CREDENTIAL_SIGNATURE_TENANT_AND_EXTERNAL_E2E_REQUIRED"
        }
      }
    },
    "officialLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "role",
        "verifiedAt",
        "retrievalStatus"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "role": {
          "type": "string",
          "enum": [
            "OFFICIAL_INVENTORY",
            "OFFICIAL_SYSTEM_PORTAL",
            "OFFICIAL_HELP",
            "OFFICIAL_PUBLIC_REGISTRY",
            "OFFICIAL_ACCESS_GUIDE",
            "OFFICIAL_TECHNICAL_PORTAL"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        },
        "retrievalStatus": {
          "type": "string",
          "enum": [
            "VERIFIED_PUBLIC",
            "VERIFIED_INDEXED",
            "OFFICIAL_LOCATOR_ACCESS_FAILED"
          ]
        }
      }
    },
    "inventoryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryCode",
        "title",
        "officialLocator",
        "verificationStatus",
        "verifiedAt",
        "coverageCodes"
      ],
      "properties": {
        "inventoryCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,80}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "officialLocator": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "VERIFIED_PUBLIC",
            "VERIFIED_INDEXED",
            "OFFICIAL_LOCATOR_ACCESS_FAILED"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        },
        "coverageCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,100}$"
          }
        }
      }
    },
    "apiArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "sha256"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "apiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "artifacts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PINNED",
            "NOT_ASSESSED",
            "NOT_APPLICABLE"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/apiArtifact"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PINNED"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "artifacts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemCode",
        "officialName",
        "shortName",
        "kind",
        "domain",
        "inventoryCodes",
        "parentSystemCode",
        "responsibleAuthority",
        "applicability",
        "evidenceClass",
        "integrationStatus",
        "accessMode",
        "platformState",
        "officialLocators",
        "apiContract",
        "readEvidence",
        "writeEvidence",
        "platformReadEnabled",
        "platformWriteEnabled",
        "credentialRequirement",
        "signatureRequirement",
        "blockers"
      ],
      "properties": {
        "systemCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,100}$"
        },
        "officialName": {
          "type": "string",
          "minLength": 3
        },
        "shortName": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "type": "string",
          "enum": [
            "SYSTEM",
            "PLATFORM",
            "UMBRELLA",
            "COMPONENT",
            "PUBLIC_REGISTRY",
            "TRANSPORT",
            "PUBLIC_INFORMATION_RESOURCE"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "MCX",
            "PLANT_PRODUCTION",
            "VETERINARY",
            "PHYTOSANITARY",
            "CHEMICAL_TRACEABILITY",
            "ACCREDITATION",
            "TRANSPORT",
            "TAX",
            "CUSTOMS",
            "AML",
            "INTERAGENCY"
          ]
        },
        "inventoryCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,80}$"
          }
        },
        "parentSystemCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_]{3,100}$"
        },
        "responsibleAuthority": {
          "type": "string",
          "minLength": 3
        },
        "applicability": {
          "type": "string",
          "enum": [
            "CORE_CROP",
            "CONDITIONAL_CROP",
            "ADJACENT",
            "OUT_OF_SCOPE_CURRENT"
          ]
        },
        "evidenceClass": {
          "type": "string",
          "enum": [
            "OFFICIAL_PRIMARY",
            "OFFICIAL_SUBORDINATE",
            "OFFICIAL_COMPONENT_HELP"
          ]
        },
        "integrationStatus": {
          "type": "string",
          "enum": [
            "CONTRACT_PINNED",
            "NOT_ASSESSED",
            "DECLARATION_ONLY"
          ]
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "PUBLIC_REGISTRY",
            "PUBLIC_INFORMATION_ONLY",
            "OFFICIAL_ACCESS_REQUIRED"
          ]
        },
        "platformState": {
          "type": "string",
          "enum": [
            "DISABLED",
            "SANDBOX_ONLY"
          ]
        },
        "officialLocators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/officialLocator"
          }
        },
        "apiContract": {
          "$ref": "#/$defs/apiContract"
        },
        "readEvidence": {
          "type": "string",
          "enum": [
            "PUBLIC_QUERY_DOCUMENTED",
            "OFFICIAL_API_DOCUMENTED",
            "PORTAL_ONLY",
            "NOT_ASSESSED",
            "NOT_APPLICABLE"
          ]
        },
        "writeEvidence": {
          "type": "string",
          "enum": [
            "OFFICIAL_API_DOCUMENTED",
            "PORTAL_ONLY",
            "NOT_ASSESSED",
            "NOT_APPLICABLE"
          ]
        },
        "platformReadEnabled": {
          "type": "boolean",
          "const": false
        },
        "platformWriteEnabled": {
          "type": "boolean",
          "const": false
        },
        "credentialRequirement": {
          "type": "string",
          "enum": [
            "REQUIRED",
            "NOT_REQUIRED",
            "NOT_ASSESSED"
          ]
        },
        "signatureRequirement": {
          "type": "string",
          "enum": [
            "REQUIRED",
            "NOT_REQUIRED",
            "NOT_ASSESSED"
          ]
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "classification",
        "targetSystemCodes",
        "observedPath",
        "observedState",
        "nextEvidence"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{2,80}$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "GOVERNMENT_SYSTEM_DECLARATION",
            "ADJACENT_SYSTEM_DECLARATION",
            "TRANSPORT_DECLARATION",
            "NON_GOVERNMENT_PROVIDER_DECLARATION",
            "VENDOR_DECLARATION"
          ]
        },
        "targetSystemCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,100}$"
          }
        },
        "observedPath": {
          "type": "string",
          "minLength": 3
        },
        "observedState": {
          "type": "string",
          "enum": [
            "MANUAL_ROUTE",
            "SIMULATION_ONLY",
            "TEST_DECLARATION",
            "MOCK_ADAPTER"
          ]
        },
        "nextEvidence": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}
