#!/usr/bin/env python3
import hashlib
import re

candidate_limit_bytes = 65_536
credential_pattern = re.compile(
    r"(?is)(-----BEGIN [A-Z ]*PRIVATE KEY-----|\b(?:github_pat_|gh[pousr]_|AKIA|ASIA|xox[baprs]-|sk-(?:proj-)?)[A-Za-z0-9_\-]{12,}|\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|authorization)\s*[:=]\s*[\"'][^\"'\r\n]{8,}[\"'])"
)
email_pattern = re.compile(r"(?i)\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b")
phone_pattern = re.compile(r"(?<!\w)(?:\+?\d[\d ().-]{8,}\d)(?!\w)")

class SensitiveOutputError(Exception):
    pass

def assert_sensitive_output_safe(candidate):
    if not isinstance(candidate, str) or not candidate.strip():
        raise SensitiveOutputError("CONTENT_INVALID")
    encoded = candidate.encode("utf-8")
    if len(encoded) > candidate_limit_bytes:
        raise SensitiveOutputError("CONTENT_TOO_LARGE")
    if credential_pattern.search(candidate):
        raise SensitiveOutputError("OUTPUT_SECRET_BLOCKED")
    if email_pattern.search(candidate) or phone_pattern.search(candidate):
        raise SensitiveOutputError("OUTPUT_PII_BLOCKED")
    return candidate

def safe_candidate_sha256(candidate):
    safe = assert_sensitive_output_safe(candidate)
    return hashlib.sha256(safe.encode("utf-8")).hexdigest()
