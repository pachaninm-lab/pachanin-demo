#!/usr/bin/env python3
import hashlib
import os
from pathlib import Path
import re
import stat

REPORT_PARTS = ("evidence", "conversion-report.json")
MODEL_PARTS = ("artifacts", "mistral-7b-instruct-v0.3-q4-k-m.gguf")
SERVER_PARTS = ("toolchain", "bin", "llama-server")
GIT_SHA_PATTERN = re.compile(r"[0-9a-f]{40}\Z")


class ConversionEvidenceError(Exception):
    pass


def reject(code):
    raise ConversionEvidenceError(code)


def _require_dict(value, code):
    if not isinstance(value, dict):
        reject(code)
    return value


def validated_conversion_root(authority):
    authority = _require_dict(authority, "AUTHORITY_INVALID")
    conversion = _require_dict(authority.get("conversion"), "AUTHORITY_CONVERSION_INVALID")
    exact_main = conversion.get("exactMainSha")
    run_id = conversion.get("workflowRunId")
    run_attempt = conversion.get("workflowRunAttempt")
    root_value = conversion.get("conversionRoot")
    if not isinstance(exact_main, str) or not GIT_SHA_PATTERN.fullmatch(exact_main):
        reject("CONVERSION_MAIN_AUTHORITY_INVALID")
    if type(run_id) is not int or run_id <= 0 or type(run_attempt) is not int or run_attempt <= 0:
        reject("CONVERSION_EXECUTION_AUTHORITY_INVALID")
    expected_root = f"/srv/tai-models/conversion-runs/{exact_main}/{run_id}-{run_attempt}"
    if not isinstance(root_value, str) or root_value != expected_root:
        reject("CONVERSION_ROOT_INVALID")
    root = Path(expected_root)
    try:
        resolved = root.resolve(strict=True)
        root_stat = root.stat(follow_symlinks=False)
    except (OSError, RuntimeError):
        reject("CONVERSION_ROOT_UNAVAILABLE")
    if resolved != root or not stat.S_ISDIR(root_stat.st_mode):
        reject("CONVERSION_ROOT_NOT_TRUSTED")
    return root


def bound_fixed_file(root, authority_value, fixed_parts, code):
    if not isinstance(root, Path) or not root.is_absolute():
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    if not isinstance(fixed_parts, tuple) or not fixed_parts or any(
        not isinstance(part, str) or not part or "/" in part or part in {".", ".."}
        for part in fixed_parts
    ):
        reject("FIXED_PATH_PARTS_INVALID")
    expected_relative = "/".join(fixed_parts)
    if not isinstance(authority_value, str) or authority_value != expected_relative:
        reject(code)
    path = root.joinpath(*fixed_parts)
    try:
        resolved = path.resolve(strict=True)
    except (OSError, RuntimeError):
        reject(code)
    if resolved != path or root not in path.parents:
        reject(code)
    return path


def open_regular_nofollow(path, code):
    if not isinstance(path, Path) or not path.is_absolute():
        reject(code)
    if not hasattr(os, "O_NOFOLLOW") or not hasattr(os, "O_CLOEXEC"):
        reject("NOFOLLOW_UNAVAILABLE")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            os.close(fd)
            reject(code)
        return fd, info
    except OSError:
        os.close(fd)
        reject(code)


def digest_regular_exact(path, expected_size, open_code, size_code):
    fd, before = open_regular_nofollow(path, open_code)
    if type(expected_size) is not int or expected_size <= 0 or before.st_size != expected_size:
        os.close(fd)
        reject(size_code)
    digest = hashlib.sha256()
    try:
        while True:
            block = os.read(fd, 8 * 1024 * 1024)
            if not block:
                break
            digest.update(block)
        after = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject("BOUND_FILE_DIGEST_FAILED")
    os.close(fd)
    if (
        before.st_dev != after.st_dev
        or before.st_ino != after.st_ino
        or before.st_size != after.st_size
        or before.st_mtime_ns != after.st_mtime_ns
    ):
        reject("BOUND_FILE_CHANGED_DURING_READ")
    return digest.hexdigest()
