#!/usr/bin/env python3
import os
import stat

REPORT_RELATIVE = "evidence/conversion-report.json"
MODEL_RELATIVE = "artifacts/mistral-7b-instruct-v0.3-q4-k-m.gguf"
SERVER_RELATIVE = "toolchain/bin/llama-server"


class ConversionEvidenceError(Exception):
    pass


class PinnedRegularFileIdentity:
    __slots__ = ("fd", "relative", "dev", "ino")

    def __init__(self, fd, relative, info):
        self.fd = fd
        self.relative = relative
        self.dev = info.st_dev
        self.ino = info.st_ino

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


def reject(code):
    raise ConversionEvidenceError(code) from None


def _directory_identity_flags():
    required = ("O_PATH", "O_CLOEXEC", "O_NOFOLLOW", "O_DIRECTORY")
    if any(not hasattr(os, name) for name in required):
        reject("PINNED_DIRECTORY_OPEN_UNAVAILABLE")
    return os.O_PATH | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY


def _file_identity_flags():
    required = ("O_PATH", "O_CLOEXEC", "O_NOFOLLOW")
    if any(not hasattr(os, name) for name in required):
        reject("PINNED_FILE_OPEN_UNAVAILABLE")
    return os.O_PATH | os.O_CLOEXEC | os.O_NOFOLLOW


def _require_pinned_root_fd(root_fd):
    if type(root_fd) is not int or root_fd < 0:
        reject("CONVERSION_ROOT_FD_INVALID")
    try:
        info = os.fstat(root_fd)
    except OSError:
        reject("CONVERSION_ROOT_FD_INVALID")
    if not stat.S_ISDIR(info.st_mode):
        reject("CONVERSION_ROOT_FD_NOT_DIRECTORY")
    return root_fd


def _open_literal_directory(parent_fd, literal_name, code):
    if literal_name not in {"evidence", "artifacts", "toolchain", "bin"}:
        reject(code)
    try:
        fd = os.open(literal_name, _directory_identity_flags(), dir_fd=parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        os.close(fd)
        reject(code)
    return fd


def _pin_literal_regular_file(parent_fd, literal_name, relative, code):
    allowed = {
        ("conversion-report.json", REPORT_RELATIVE),
        ("mistral-7b-instruct-v0.3-q4-k-m.gguf", MODEL_RELATIVE),
        ("llama-server", SERVER_RELATIVE),
    }
    if (literal_name, relative) not in allowed:
        reject(code)
    try:
        fd = os.open(literal_name, _file_identity_flags(), dir_fd=parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISREG(info.st_mode):
        os.close(fd)
        reject(code)
    return PinnedRegularFileIdentity(fd, relative, info)


def pin_conversion_report_identity(root_fd, authority_relative):
    _require_pinned_root_fd(root_fd)
    if authority_relative != REPORT_RELATIVE:
        reject("CONVERSION_REPORT_PATH_INVALID")
    evidence_fd = _open_literal_directory(root_fd, "evidence", "CONVERSION_REPORT_PARENT_INVALID")
    try:
        return _pin_literal_regular_file(
            evidence_fd,
            "conversion-report.json",
            REPORT_RELATIVE,
            "CONVERSION_REPORT_IDENTITY_INVALID",
        )
    finally:
        try:
            os.close(evidence_fd)
        except OSError:
            pass


def pin_mistral_model_identity(root_fd, authority_relative):
    _require_pinned_root_fd(root_fd)
    if authority_relative != MODEL_RELATIVE:
        reject("CONVERSION_MODEL_PATH_INVALID")
    artifacts_fd = _open_literal_directory(root_fd, "artifacts", "CONVERSION_MODEL_PARENT_INVALID")
    try:
        return _pin_literal_regular_file(
            artifacts_fd,
            "mistral-7b-instruct-v0.3-q4-k-m.gguf",
            MODEL_RELATIVE,
            "CONVERSION_MODEL_IDENTITY_INVALID",
        )
    finally:
        try:
            os.close(artifacts_fd)
        except OSError:
            pass


def pin_llama_server_identity(root_fd, authority_relative):
    _require_pinned_root_fd(root_fd)
    if authority_relative != SERVER_RELATIVE:
        reject("CONVERSION_SERVER_PATH_INVALID")
    toolchain_fd = _open_literal_directory(root_fd, "toolchain", "CONVERSION_SERVER_PARENT_INVALID")
    bin_fd = None
    try:
        bin_fd = _open_literal_directory(toolchain_fd, "bin", "CONVERSION_SERVER_PARENT_INVALID")
        return _pin_literal_regular_file(
            bin_fd,
            "llama-server",
            SERVER_RELATIVE,
            "CONVERSION_SERVER_IDENTITY_INVALID",
        )
    finally:
        if bin_fd is not None:
            try:
                os.close(bin_fd)
            except OSError:
                pass
        try:
            os.close(toolchain_fd)
        except OSError:
            pass
