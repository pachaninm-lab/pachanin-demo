#!/usr/bin/env python3
import fcntl
import hashlib
import os
import re
import stat

ROOT_PREFIX_PARTS = ("srv", "tai-models", "conversion-runs")
REPORT_PARTS = ("evidence", "conversion-report.json")
MODEL_PARTS = ("artifacts", "mistral-7b-instruct-v0.3-q4-k-m.gguf")
SERVER_PARTS = ("toolchain", "bin", "llama-server")
ALLOWED_FIXED_PARTS = frozenset((REPORT_PARTS, MODEL_PARTS, SERVER_PARTS))
FIXED_DIRECTORY_NAMES = frozenset((
    "srv",
    "tai-models",
    "conversion-runs",
    "evidence",
    "artifacts",
    "toolchain",
    "bin",
))
ALLOWED_BOUND_IDENTITIES = frozenset((
    ("conversion-report.json", "evidence/conversion-report.json"),
    ("mistral-7b-instruct-v0.3-q4-k-m.gguf", "artifacts/mistral-7b-instruct-v0.3-q4-k-m.gguf"),
    ("llama-server", "toolchain/bin/llama-server"),
))
GIT_SHA_PATTERN = re.compile(r"[0-9a-f]{40}\Z")
SHA256_PATTERN = re.compile(r"[0-9a-f]{64}\Z")
READ_CHUNK_BYTES = 8 * 1024 * 1024
SNAPSHOT_NAME = "pc-mistral-conversion-evidence"


class ConversionEvidenceError(Exception):
    pass


class ValidatedRoot:
    __slots__ = ("fd", "literal")

    def __init__(self, fd, literal):
        self.fd = fd
        self.literal = literal

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


class BoundFile:
    __slots__ = ("parent_fd", "name", "relative")

    def __init__(self, parent_fd, name, relative):
        self.parent_fd = parent_fd
        self.name = name
        self.relative = relative

    def close(self):
        if self.parent_fd is not None:
            os.close(self.parent_fd)
            self.parent_fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


class VerifiedRegularFile:
    __slots__ = ("fd", "sha256", "size", "source_dev", "source_ino", "relative")

    def __init__(self, fd, sha256, size, source_dev, source_ino, relative):
        self.fd = fd
        self.sha256 = sha256
        self.size = size
        self.source_dev = source_dev
        self.source_ino = source_ino
        self.relative = relative

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


def reject(code):
    raise ConversionEvidenceError(code)


def _require_dict(value, code):
    if not isinstance(value, dict):
        reject(code)
    return value


def _secure_flags(directory=False):
    required = ("O_CLOEXEC", "O_NOFOLLOW")
    if directory:
        required += ("O_DIRECTORY",)
    if any(not hasattr(os, name) for name in required):
        reject("SECURE_OPEN_FLAGS_UNAVAILABLE")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    if directory:
        flags |= os.O_DIRECTORY
    return flags


def _open_fixed_directory_at(parent_fd, part, code):
    if not isinstance(part, str) or part not in FIXED_DIRECTORY_NAMES:
        reject(code)
    try:
        fd = os.open(part, _secure_flags(directory=True), dir_fd=parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        os.close(fd)
        reject(code)
    return fd


def _open_exact_main_directory_at(parent_fd, exact_main, code):
    if not isinstance(exact_main, str) or not GIT_SHA_PATTERN.fullmatch(exact_main):
        reject(code)
    try:
        fd = os.open(exact_main, _secure_flags(directory=True), dir_fd=parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        os.close(fd)
        reject(code)
    return fd


def _open_run_attempt_directory_at(parent_fd, run_id, run_attempt, code):
    if type(run_id) is not int or run_id <= 0 or type(run_attempt) is not int or run_attempt <= 0:
        reject(code)
    execution_part = f"{run_id}-{run_attempt}"
    try:
        fd = os.open(execution_part, _secure_flags(directory=True), dir_fd=parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        os.close(fd)
        reject(code)
    return fd


def validated_conversion_root(authority):
    authority = _require_dict(authority, "AUTHORITY_INVALID")
    conversion = _require_dict(authority.get("conversion"), "AUTHORITY_CONVERSION_INVALID")
    exact_main = conversion.get("exactMainSha")
    run_id = conversion.get("workflowRunId")
    run_attempt = conversion.get("workflowRunAttempt")
    root_value = conversion.get("conversionRoot")
    if not isinstance(exact_main, str) or not GIT_SHA_PATTERN.fullmatch(exact_main):
        reject("CONVERSION_MAIN_AUTHORITY_INVALID")
    if type(run_id) is not int or run_id <= 0 or type(run_attempt) is not int or run_attempt <= 0:
        reject("CONVERSION_EXECUTION_AUTHORITY_INVALID")
    execution_part = f"{run_id}-{run_attempt}"
    expected_root = f"/srv/tai-models/conversion-runs/{exact_main}/{execution_part}"
    if not isinstance(root_value, str) or root_value != expected_root:
        reject("CONVERSION_ROOT_INVALID")

    try:
        current_fd = os.open("/", _secure_flags(directory=True))
    except OSError:
        reject("CONVERSION_ROOT_OPEN_FAILED")
    try:
        for part in ROOT_PREFIX_PARTS:
            next_fd = _open_fixed_directory_at(current_fd, part, "CONVERSION_ROOT_NOT_TRUSTED")
            os.close(current_fd)
            current_fd = next_fd
        next_fd = _open_exact_main_directory_at(
            current_fd,
            exact_main,
            "CONVERSION_ROOT_NOT_TRUSTED",
        )
        os.close(current_fd)
        current_fd = next_fd
        next_fd = _open_run_attempt_directory_at(
            current_fd,
            run_id,
            run_attempt,
            "CONVERSION_ROOT_NOT_TRUSTED",
        )
        os.close(current_fd)
        current_fd = next_fd
        return ValidatedRoot(current_fd, expected_root)
    except Exception:
        try:
            os.close(current_fd)
        except OSError:
            pass
        raise


def _validate_root_handle(root):
    if not isinstance(root, ValidatedRoot) or root.fd is None:
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    try:
        info = os.fstat(root.fd)
    except OSError:
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    if not stat.S_ISDIR(info.st_mode):
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    return root


def bound_fixed_file(root, authority_value, fixed_parts, code):
    root = _validate_root_handle(root)
    if not isinstance(fixed_parts, tuple) or fixed_parts not in ALLOWED_FIXED_PARTS:
        reject("FIXED_PATH_NOT_ALLOWED")
    expected_relative = "/".join(fixed_parts)
    if not isinstance(authority_value, str) or authority_value != expected_relative:
        reject(code)

    try:
        current_fd = os.dup(root.fd)
    except OSError:
        reject(code)
    try:
        for part in fixed_parts[:-1]:
            next_fd = _open_fixed_directory_at(current_fd, part, code)
            os.close(current_fd)
            current_fd = next_fd
        name = fixed_parts[-1]
        identity = (name, expected_relative)
        if identity not in ALLOWED_BOUND_IDENTITIES:
            reject("BOUND_FILE_IDENTITY_NOT_ALLOWED")
        return BoundFile(current_fd, name, expected_relative)
    except Exception:
        try:
            os.close(current_fd)
        except OSError:
            pass
        raise


def _validate_bound_file(bound, code):
    if not isinstance(bound, BoundFile) or bound.parent_fd is None:
        reject(code)
    if (bound.name, bound.relative) not in ALLOWED_BOUND_IDENTITIES:
        reject(code)
    try:
        info = os.fstat(bound.parent_fd)
    except OSError:
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        reject(code)
    return bound


def open_regular_nofollow(bound, code):
    bound = _validate_bound_file(bound, code)
    try:
        fd = os.open(bound.name, _secure_flags(directory=False), dir_fd=bound.parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISREG(info.st_mode):
        os.close(fd)
        reject(code)
    return fd, info


def _same_identity(left, right):
    return (
        left.st_dev == right.st_dev
        and left.st_ino == right.st_ino
        and left.st_size == right.st_size
        and left.st_mtime_ns == right.st_mtime_ns
        and left.st_ctime_ns == right.st_ctime_ns
    )


def _snapshot_seal_contract():
    os_required = ("memfd_create", "MFD_CLOEXEC", "MFD_ALLOW_SEALING")
    fcntl_required = (
        "F_ADD_SEALS",
        "F_GET_SEALS",
        "F_SEAL_SEAL",
        "F_SEAL_SHRINK",
        "F_SEAL_GROW",
        "F_SEAL_WRITE",
    )
    if any(not hasattr(os, name) for name in os_required):
        reject("SEALED_SNAPSHOT_UNAVAILABLE")
    if any(not hasattr(fcntl, name) for name in fcntl_required):
        reject("SEALED_SNAPSHOT_UNAVAILABLE")
    flags = os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING
    seals = (
        fcntl.F_SEAL_SEAL
        | fcntl.F_SEAL_SHRINK
        | fcntl.F_SEAL_GROW
        | fcntl.F_SEAL_WRITE
    )
    return flags, seals


def _stable_source_stat(fd, baseline):
    try:
        current = os.fstat(fd)
    except OSError:
        reject("BOUND_FILE_STAT_FAILED")
    if not _same_identity(baseline, current):
        reject("BOUND_FILE_CHANGED_DURING_READ")
    return current


def _write_all(fd, data):
    offset = 0
    while offset < len(data):
        try:
            written = os.write(fd, data[offset:])
        except OSError:
            reject("SEALED_SNAPSHOT_WRITE_FAILED")
        if written <= 0:
            reject("SEALED_SNAPSHOT_WRITE_FAILED")
        offset += written


def _copy_source_to_snapshot(source_fd, snapshot_fd, baseline, expected_size, size_code):
    try:
        os.lseek(source_fd, 0, os.SEEK_SET)
    except OSError:
        reject("BOUND_FILE_SEEK_FAILED")
    digest = hashlib.sha256()
    bytes_read = 0
    while True:
        _stable_source_stat(source_fd, baseline)
        try:
            block = os.read(source_fd, READ_CHUNK_BYTES)
        except OSError:
            reject("BOUND_FILE_DIGEST_FAILED")
        _stable_source_stat(source_fd, baseline)
        if not block:
            break
        bytes_read += len(block)
        if bytes_read > expected_size:
            reject(size_code)
        digest.update(block)
        _write_all(snapshot_fd, block)
    if bytes_read != expected_size:
        reject(size_code)
    _stable_source_stat(source_fd, baseline)
    return digest.hexdigest()


def _hash_snapshot_exact(fd, expected_size, size_code):
    try:
        os.lseek(fd, 0, os.SEEK_SET)
    except OSError:
        reject("SEALED_SNAPSHOT_SEEK_FAILED")
    digest = hashlib.sha256()
    bytes_read = 0
    while True:
        try:
            block = os.read(fd, READ_CHUNK_BYTES)
        except OSError:
            reject("SEALED_SNAPSHOT_READ_FAILED")
        if not block:
            break
        bytes_read += len(block)
        if bytes_read > expected_size:
            reject(size_code)
        digest.update(block)
    if bytes_read != expected_size:
        reject(size_code)
    return digest.hexdigest()


def verify_regular_exact(
    bound,
    expected_size,
    expected_sha256,
    open_code,
    size_code,
    sha_code,
):
    if type(expected_size) is not int or expected_size <= 0:
        reject(size_code)
    if not isinstance(expected_sha256, str) or not SHA256_PATTERN.fullmatch(expected_sha256):
        reject(sha_code)

    source_fd, opened = open_regular_nofollow(bound, open_code)
    snapshot_fd = None
    try:
        try:
            baseline = os.fstat(source_fd)
        except OSError:
            reject("BOUND_FILE_STAT_FAILED")
        if not _same_identity(opened, baseline) or baseline.st_size != expected_size:
            reject(size_code)

        memfd_flags, required_seals = _snapshot_seal_contract()
        try:
            snapshot_fd = os.memfd_create(SNAPSHOT_NAME, memfd_flags)
        except OSError:
            reject("SEALED_SNAPSHOT_CREATE_FAILED")

        actual_sha256 = _copy_source_to_snapshot(
            source_fd,
            snapshot_fd,
            baseline,
            expected_size,
            size_code,
        )
        if actual_sha256 != expected_sha256:
            reject(sha_code)

        try:
            snapshot_info = os.fstat(snapshot_fd)
        except OSError:
            reject("SEALED_SNAPSHOT_STAT_FAILED")
        if not stat.S_ISREG(snapshot_info.st_mode) or snapshot_info.st_size != expected_size:
            reject(size_code)

        try:
            fcntl.fcntl(snapshot_fd, fcntl.F_ADD_SEALS, required_seals)
            observed_seals = fcntl.fcntl(snapshot_fd, fcntl.F_GET_SEALS)
        except OSError:
            reject("SEALED_SNAPSHOT_SEAL_FAILED")
        if observed_seals & required_seals != required_seals:
            reject("SEALED_SNAPSHOT_SEAL_FAILED")

        sealed_sha256 = _hash_snapshot_exact(snapshot_fd, expected_size, size_code)
        if sealed_sha256 != expected_sha256 or sealed_sha256 != actual_sha256:
            reject(sha_code)
        try:
            os.lseek(snapshot_fd, 0, os.SEEK_SET)
        except OSError:
            reject("SEALED_SNAPSHOT_SEEK_FAILED")

        verified = VerifiedRegularFile(
            fd=snapshot_fd,
            sha256=sealed_sha256,
            size=expected_size,
            source_dev=baseline.st_dev,
            source_ino=baseline.st_ino,
            relative=bound.relative,
        )
        snapshot_fd = None
        return verified
    finally:
        try:
            os.close(source_fd)
        except OSError:
            pass
        if snapshot_fd is not None:
            try:
                os.close(snapshot_fd)
            except OSError:
                pass
