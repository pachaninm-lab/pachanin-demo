#!/usr/bin/env python3
import fcntl
import hashlib
import os
import re
import stat

ROOT_PREFIX_PARTS = ("srv", "tai-models", "conversion-runs")
REPORT_PARTS = ("evidence", "conversion-report.json")
MODEL_PARTS = ("artifacts", "mistral-7b-instruct-v0.3-q4-k-m.gguf")
SERVER_PARTS = ("toolchain", "bin", "llama-server")
ALLOWED_FIXED_PARTS = frozenset((REPORT_PARTS, MODEL_PARTS, SERVER_PARTS))
GIT_SHA_PATTERN = re.compile(r"[0-9a-f]{40}\Z")
SHA256_PATTERN = re.compile(r"[0-9a-f]{64}\Z")
READ_CHUNK_BYTES = 8 * 1024 * 1024


class ConversionEvidenceError(Exception):
    pass


class ValidatedRoot:
    __slots__ = ("fd", "literal")

    def __init__(self, fd, literal):
        self.fd = fd
        self.literal = literal

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


class BoundFile:
    __slots__ = ("parent_fd", "name", "relative")

    def __init__(self, parent_fd, name, relative):
        self.parent_fd = parent_fd
        self.name = name
        self.relative = relative

    def close(self):
        if self.parent_fd is not None:
            os.close(self.parent_fd)
            self.parent_fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


class VerifiedRegularFile:
    __slots__ = ("fd", "sha256", "size", "dev", "ino", "relative")

    def __init__(self, fd, sha256, size, dev, ino, relative):
        self.fd = fd
        self.sha256 = sha256
        self.size = size
        self.dev = dev
        self.ino = ino
        self.relative = relative

    def close(self):
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
                self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


def reject(code):
    raise ConversionEvidenceError(code)


def _require_dict(value, code):
    if not isinstance(value, dict):
        reject(code)
    return value


def _secure_flags(directory=False):
    required = ("O_CLOEXEC", "O_NOFOLLOW")
    if directory:
        required += ("O_DIRECTORY",)
    if any(not hasattr(os, name) for name in required):
        reject("SECURE_OPEN_FLAGS_UNAVAILABLE")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    if directory:
        flags |= os.O_DIRECTORY
    return flags


def _validate_part(part, code):
    if (
        not isinstance(part, str)
        or not part
        or part in {".", ".."}
        or "/" in part
        or "\x00" in part
    ):
        reject(code)
    return part


def _open_directory_at(parent_fd, part, code):
    _validate_part(part, code)
    try:
        fd = os.open(part, _secure_flags(directory=True), dir_fd=parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        os.close(fd)
        reject(code)
    return fd


def validated_conversion_root(authority):
    authority = _require_dict(authority, "AUTHORITY_INVALID")
    conversion = _require_dict(authority.get("conversion"), "AUTHORITY_CONVERSION_INVALID")
    exact_main = conversion.get("exactMainSha")
    run_id = conversion.get("workflowRunId")
    run_attempt = conversion.get("workflowRunAttempt")
    root_value = conversion.get("conversionRoot")
    if not isinstance(exact_main, str) or not GIT_SHA_PATTERN.fullmatch(exact_main):
        reject("CONVERSION_MAIN_AUTHORITY_INVALID")
    if type(run_id) is not int or run_id <= 0 or type(run_attempt) is not int or run_attempt <= 0:
        reject("CONVERSION_EXECUTION_AUTHORITY_INVALID")
    execution_part = f"{run_id}-{run_attempt}"
    root_parts = (*ROOT_PREFIX_PARTS, exact_main, execution_part)
    expected_root = "/" + "/".join(root_parts)
    if not isinstance(root_value, str) or root_value != expected_root:
        reject("CONVERSION_ROOT_INVALID")

    try:
        current_fd = os.open("/", _secure_flags(directory=True))
    except OSError:
        reject("CONVERSION_ROOT_OPEN_FAILED")
    try:
        for part in root_parts:
            next_fd = _open_directory_at(current_fd, part, "CONVERSION_ROOT_NOT_TRUSTED")
            os.close(current_fd)
            current_fd = next_fd
        return ValidatedRoot(current_fd, expected_root)
    except Exception:
        try:
            os.close(current_fd)
        except OSError:
            pass
        raise


def _validate_root_handle(root):
    if not isinstance(root, ValidatedRoot) or root.fd is None:
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    try:
        info = os.fstat(root.fd)
    except OSError:
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    if not stat.S_ISDIR(info.st_mode):
        reject("CONVERSION_ROOT_HANDLE_INVALID")
    return root


def bound_fixed_file(root, authority_value, fixed_parts, code):
    root = _validate_root_handle(root)
    if not isinstance(fixed_parts, tuple) or fixed_parts not in ALLOWED_FIXED_PARTS:
        reject("FIXED_PATH_NOT_ALLOWED")
    for part in fixed_parts:
        _validate_part(part, "FIXED_PATH_PARTS_INVALID")
    expected_relative = "/".join(fixed_parts)
    if not isinstance(authority_value, str) or authority_value != expected_relative:
        reject(code)

    try:
        current_fd = os.dup(root.fd)
    except OSError:
        reject(code)
    try:
        for part in fixed_parts[:-1]:
            next_fd = _open_directory_at(current_fd, part, code)
            os.close(current_fd)
            current_fd = next_fd
        return BoundFile(current_fd, fixed_parts[-1], expected_relative)
    except Exception:
        try:
            os.close(current_fd)
        except OSError:
            pass
        raise


def _validate_bound_file(bound, code):
    if not isinstance(bound, BoundFile) or bound.parent_fd is None:
        reject(code)
    _validate_part(bound.name, code)
    try:
        info = os.fstat(bound.parent_fd)
    except OSError:
        reject(code)
    if not stat.S_ISDIR(info.st_mode):
        reject(code)
    return bound


def open_regular_nofollow(bound, code):
    bound = _validate_bound_file(bound, code)
    try:
        fd = os.open(bound.name, _secure_flags(directory=False), dir_fd=bound.parent_fd)
    except OSError:
        reject(code)
    try:
        info = os.fstat(fd)
    except OSError:
        os.close(fd)
        reject(code)
    if not stat.S_ISREG(info.st_mode):
        os.close(fd)
        reject(code)
    return fd, info


def _same_identity(left, right):
    return (
        left.st_dev == right.st_dev
        and left.st_ino == right.st_ino
        and left.st_size == right.st_size
        and left.st_mtime_ns == right.st_mtime_ns
        and left.st_ctime_ns == right.st_ctime_ns
    )


def _hash_exact_pass(fd, expected_size, size_code):
    try:
        os.lseek(fd, 0, os.SEEK_SET)
    except OSError:
        reject("BOUND_FILE_SEEK_FAILED")
    digest = hashlib.sha256()
    bytes_read = 0
    while True:
        try:
            block = os.read(fd, READ_CHUNK_BYTES)
        except OSError:
            reject("BOUND_FILE_DIGEST_FAILED")
        if not block:
            break
        bytes_read += len(block)
        if bytes_read > expected_size:
            reject(size_code)
        digest.update(block)
    if bytes_read != expected_size:
        reject(size_code)
    return digest.hexdigest()


def _unlock_close(fd):
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def verify_regular_exact(
    bound,
    expected_size,
    expected_sha256,
    open_code,
    size_code,
    sha_code,
):
    if type(expected_size) is not int or expected_size <= 0:
        reject(size_code)
    if not isinstance(expected_sha256, str) or not SHA256_PATTERN.fullmatch(expected_sha256):
        reject(sha_code)

    fd, opened = open_regular_nofollow(bound, open_code)
    locked = False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            locked = True
        except OSError:
            reject("BOUND_FILE_SHARED_LOCK_FAILED")

        try:
            before = os.fstat(fd)
        except OSError:
            reject("BOUND_FILE_STAT_FAILED")
        if not _same_identity(opened, before) or before.st_size != expected_size:
            reject(size_code)

        first_sha256 = _hash_exact_pass(fd, expected_size, size_code)
        try:
            middle = os.fstat(fd)
        except OSError:
            reject("BOUND_FILE_STAT_FAILED")
        if not _same_identity(before, middle):
            reject("BOUND_FILE_CHANGED_DURING_READ")
        if first_sha256 != expected_sha256:
            reject(sha_code)

        second_sha256 = _hash_exact_pass(fd, expected_size, size_code)
        try:
            after = os.fstat(fd)
        except OSError:
            reject("BOUND_FILE_STAT_FAILED")
        if not _same_identity(middle, after):
            reject("BOUND_FILE_CHANGED_DURING_READ")
        if second_sha256 != first_sha256 or second_sha256 != expected_sha256:
            reject(sha_code)

        try:
            os.lseek(fd, 0, os.SEEK_SET)
        except OSError:
            reject("BOUND_FILE_SEEK_FAILED")

        verified = VerifiedRegularFile(
            fd=fd,
            sha256=second_sha256,
            size=expected_size,
            dev=after.st_dev,
            ino=after.st_ino,
            relative=bound.relative,
        )
        fd = None
        locked = False
        return verified
    finally:
        if fd is not None:
            if locked:
                _unlock_close(fd)
            else:
                try:
                    os.close(fd)
                except OSError:
                    pass
