  "requiredBehavior": [
    "remove production login and registration demo fallbacks",
    "reject role selection or role inference from public client input",
    "persist registration admission membership credentials sessions invitations MFA recovery and audit state in PostgreSQL",
    "keep membership pending and non-privileged until an authorized audited decision",
    "bind current consent versions to immutable server-recorded source hashes",
    "support single-use hashed email password-reset invitation MFA and membership-selection tokens with bounded TTL",
    "require recent MFA reason idempotency optimistic concurrency and no self-approval for protected decisions",
    "route every authenticated user from server-resolved tenant membership role and MFA state",
    "enforce organization-scoped invitation join membership role revoke and MFA-recovery ceilings",
    "keep API database mail and production dependency failures fail-closed",
    "preserve RU EN ZH mobile keyboard and accessible public entry surfaces"
  ],
