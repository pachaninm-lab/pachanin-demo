// Прозрачная Цена — self-discovery для connector protocol v1.
//
// Платформенную версию получаем из стандартной СистемнаяИнформация. Всё, что
// зависит от конкретного прикладного решения (версия конфигурации, список
// юридических лиц и их GUID), приходит только из принятого compatibility adapter.
// Это намеренно: универсальный запрос к "Организациям" был бы скрытым обещанием,
// что все конфигурации 1С устроены одинаково.

Перем ВерсияКоннектора Экспорт;
Перем ВерсияПротокола Экспорт;

Процедура ИнициализироватьDiscoveryКонстанты() Экспорт
    ВерсияКоннектора = "1.0.0";
    ВерсияПротокола = "1";
КонецПроцедуры

Функция ПолеDiscovery(Объект, ИмяПоля, ЗначениеПоУмолчанию = Неопределено)
    Если Объект = Неопределено Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;

    Если ТипЗнч(Объект) = Тип("Структура") Тогда
        Значение = Неопределено;
        Если Объект.Свойство(ИмяПоля, Значение) Тогда
            Возврат Значение;
        КонецЕсли;
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;

    Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
        Значение = Объект.Получить(ИмяПоля);
        Если Значение = Неопределено Тогда
            Возврат ЗначениеПоУмолчанию;
        КонецЕсли;
        Возврат Значение;
    КонецЕсли;

    Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция НовыйРезультатDiscovery(Ready, ResultCode, Discovery = Неопределено)
    Результат = Новый Структура;
    Результат.Вставить("ready", Ready);
    Результат.Вставить("resultCode", ResultCode);
    Результат.Вставить("discovery", Discovery);
    Возврат Результат;
КонецФункции

Функция ТолькоЦифры(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Номер, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция БезопасныйИНН(ИНН)
    Если ТипЗнч(ИНН) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;
    ИНН = СокрЛП(ИНН);
    Если (СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12)
        Или Не ТолькоЦифры(ИНН) Тогда
        Возврат "";
    КонецЕсли;
    Возврат ИНН;
КонецФункции

Функция БезопасныйКПП(КПП)
    Если КПП = Неопределено Или КПП = Null Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если ТипЗнч(КПП) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    КПП = СокрЛП(КПП);
    Если ПустаяСтрока(КПП) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если СтрДлина(КПП) <> 9 Или Не ТолькоЦифры(КПП) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат КПП;
КонецФункции

Функция НормализоватьОрганизации(Организации) Экспорт
    Если ТипЗнч(Организации) <> Тип("Массив") Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATIONS_NOT_ARRAY");
    КонецЕсли;
    Если Организации.Количество() = 0 Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATIONS_EMPTY");
    КонецЕсли;
    Если Организации.Количество() > 500 Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATIONS_LIMIT_EXCEEDED");
    КонецЕсли;

    УникальныеGUID = Новый Соответствие;
    Нормализованные = Новый Массив;

    Для Каждого Организация Из Организации Цикл
        GUID = TransparentPriceConnectorHttp.БезопасныйИдентификаторURL(
            ПолеDiscovery(Организация, "guid", ""));
        ИНН = БезопасныйИНН(ПолеDiscovery(Организация, "inn", ""));
        КППИсходный = ПолеDiscovery(Организация, "kpp", Неопределено);
        КПП = БезопасныйКПП(КППИсходный);
        Имя = ПолеDiscovery(Организация, "name", "");

        Если ПустаяСтрока(GUID) Тогда
            Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATION_GUID_INVALID");
        КонецЕсли;
        Если УникальныеGUID.Получить(GUID) <> Неопределено Тогда
            Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATION_GUID_DUPLICATE");
        КонецЕсли;
        Если ПустаяСтрока(ИНН) Тогда
            Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATION_INN_INVALID");
        КонецЕсли;
        Если КППИсходный <> Неопределено
            И КППИсходный <> Null
            И Не ПустаяСтрока(СокрЛП(Строка(КППИсходный)))
            И КПП = Неопределено Тогда
            Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATION_KPP_INVALID");
        КонецЕсли;
        Если ТипЗнч(Имя) <> Тип("Строка")
            Или ПустаяСтрока(СокрЛП(Имя))
            Или СтрДлина(Имя) > 512 Тогда
            Возврат НовыйРезультатDiscovery(Ложь, "ORGANIZATION_NAME_INVALID");
        КонецЕсли;

        УникальныеGUID.Вставить(GUID, Истина);
        СтрокаОрганизации = Новый Структура;
        СтрокаОрганизации.Вставить("guid", GUID);
        СтрокаОрганизации.Вставить("inn", ИНН);
        СтрокаОрганизации.Вставить("kpp", КПП);
        СтрокаОрганизации.Вставить("name", СокрЛП(Имя));
        Нормализованные.Добавить(СтрокаОрганизации);
    КонецЦикла;

    Возврат НовыйРезультатDiscovery(Истина, "OK", Нормализованные);
КонецФункции

Функция СобратьDiscovery() Экспорт
    Если ПустаяСтрока(ВерсияКоннектора) Тогда
        ИнициализироватьDiscoveryКонстанты();
    КонецЕсли;

    Профиль = TransparentPriceConfigurationAdapter.ПолучитьПрофильDiscovery();
    Если ПолеDiscovery(Профиль, "ready", Ложь) <> Истина Тогда
        Возврат НовыйРезультатDiscovery(
            Ложь,
            ПолеDiscovery(Профиль, "resultCode", "CONFIGURATION_DISCOVERY_NOT_IMPLEMENTED"));
    КонецЕсли;

    ИмяКонфигурации = ПолеDiscovery(Профиль, "configurationName", "");
    ВерсияКонфигурации = ПолеDiscovery(Профиль, "configurationVersion", "");
    DatabaseInstanceId = TransparentPriceConnectorHttp.БезопасныйИдентификаторURL(
        ПолеDiscovery(Профиль, "databaseInstanceId", ""));

    Если ТипЗнч(ИмяКонфигурации) <> Тип("Строка")
        Или ПустаяСтрока(СокрЛП(ИмяКонфигурации))
        Или СтрДлина(ИмяКонфигурации) > 256 Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "CONFIGURATION_NAME_INVALID");
    КонецЕсли;
    Если ТипЗнч(ВерсияКонфигурации) <> Тип("Строка")
        Или ПустаяСтрока(СокрЛП(ВерсияКонфигурации))
        Или СтрДлина(ВерсияКонфигурации) > 128 Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "CONFIGURATION_VERSION_INVALID");
    КонецЕсли;
    Если ПустаяСтрока(DatabaseInstanceId) Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "DATABASE_INSTANCE_ID_INVALID");
    КонецЕсли;

    Организации = НормализоватьОрганизации(
        ПолеDiscovery(Профиль, "organizations", Неопределено));
    Если Организации.ready <> Истина Тогда
        Возврат Организации;
    КонецЕсли;

    СистемнаяИнформация = Новый СистемнаяИнформация;
    ВерсияПлатформы = Строка(СистемнаяИнформация.ВерсияПриложения);
    Если ПустаяСтрока(СокрЛП(ВерсияПлатформы)) Тогда
        Возврат НовыйРезультатDiscovery(Ложь, "PLATFORM_VERSION_UNAVAILABLE");
    КонецЕсли;

    Discovery = Новый Структура;
    Discovery.Вставить("platformVersion", ВерсияПлатформы);
    Discovery.Вставить("configurationName", СокрЛП(ИмяКонфигурации));
    Discovery.Вставить("configurationVersion", СокрЛП(ВерсияКонфигурации));
    Discovery.Вставить("databaseInstanceId", DatabaseInstanceId);
    Discovery.Вставить("organizations", Организации.discovery);
    Discovery.Вставить("capabilities", TransparentPriceConnectorCommands.РазрешенныеКоманды());
    Discovery.Вставить("connectorVersion", ВерсияКоннектора);
    Discovery.Вставить("protocolVersion", ВерсияПротокола);

    Возврат НовыйРезультатDiscovery(Истина, "OK", Discovery);
КонецФункции

Функция ВыполнитьБезопасныйPairing(ОдноразовыйКод, CorrelationId = "") Экспорт
    DiscoveryResult = СобратьDiscovery();
    Если DiscoveryResult.ready <> Истина Тогда
        Возврат DiscoveryResult;
    КонецЕсли;

    Возврат TransparentPriceConnectorHttp.ВыполнитьPairing(
        ОдноразовыйКод,
        DiscoveryResult.discovery,
        CorrelationId);
КонецФункции
