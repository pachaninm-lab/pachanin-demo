// Прозрачная Цена — 1С Connector reference source.
//
// Это ОБЩИЙ МОДУЛЬ расширения 1С, выполняющий только исходящие HTTPS-запросы.
// В нём намеренно нет HTTP-сервиса, входящего listener, OData, удалённого рабочего
// стола или произвольного URL. Машинный bearer передаётся только на compile-time
// закреплённый host платформы.
//
// ВАЖНО: модуль не отвечает за хранение bearer. Конфигурационный слой обязан
// отдавать секрет из защищённого хранилища (например, БСП safe storage), а не из
// обычного регистра/константы. В журнал регистрации bearer не писать.

Перем СерверПлатформы Экспорт;
Перем БазовыйПуть Экспорт;

Процедура ИнициализироватьКонстанты() Экспорт
    // Один production host. Никакой host из задания/документа/пользовательского
    // поля не может подменить адрес, куда уйдёт Authorization header.
    СерверПлатформы = "xn----8sbjf4befbjgs9b.xn--p1ai";
    БазовыйПуть = "/connector/v1";
КонецПроцедуры

Функция НовоеHTTPSСоединение() Экспорт
    Если ПустаяСтрока(СерверПлатформы) Тогда
        ИнициализироватьКонстанты();
    КонецЕсли;

    // Проверка сертификата сервера выполняется через доверенные корневые
    // сертификаты ОС. Plain HTTP в этом модуле не представлен.
    ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(
        , Новый СертификатыУдостоверяющихЦентровОС);

    // Порт 443, без HTTP Basic credentials. Таймаут ограничен 20 секундами.
    Возврат Новый HTTPСоединение(
        СерверПлатформы,
        443,
        ,
        ,
        ,
        20,
        ЗащищенноеСоединение);
КонецФункции

Функция ДопустимыйПуть(Путь) Экспорт
    Если ТипЗнч(Путь) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Лев(Путь, СтрДлина(БазовыйПуть)) <> БазовыйПуть Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрНайти(Путь, "://") > 0
        Или СтрНайти(Путь, "..") > 0
        Или СтрНайти(Путь, "\\") > 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция ЗначениеВJSON(Значение) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция JSONВЗначение(СтрокаJSON) Экспорт
    Если ПустаяСтрока(СтрокаJSON) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция НовыйРезультатТранспорта(Состояние, КодHTTP = 0, Код = "")
    Результат = Новый Структура;
    Результат.Вставить("Состояние", Состояние);
    Результат.Вставить("КодHTTP", КодHTTP);
    Результат.Вставить("Код", Код);
    Результат.Вставить("Ответ", Неопределено);
    Возврат Результат;
КонецФункции

Функция ВыполнитьJSONЗапрос(Метод, Путь, Тело, Bearer, CorrelationId) Экспорт
    Если ПустаяСтрока(СерверПлатформы) Тогда
        ИнициализироватьКонстанты();
    КонецЕсли;

    Если Не ДопустимыйПуть(Путь) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "PATH_REFUSED");
    КонецЕсли;

    МетодВерх = ВРег(Метод);
    Если МетодВерх <> "GET" И МетодВерх <> "POST" Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "METHOD_REFUSED");
    КонецЕсли;

    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Запрос.Заголовки.Вставить("X-PC-Connector-Protocol", "1");
    Запрос.Заголовки.Вставить("User-Agent", "TransparentPrice-1C-Connector/1");

    Если Не ПустаяСтрока(CorrelationId) Тогда
        Запрос.Заголовки.Вставить("X-Correlation-Id", Лев(CorrelationId, 128));
    КонецЕсли;

    // Bearer прикрепляется только ПОСЛЕ того, как путь зафиксирован относительно
    // закреплённого host. Код не умеет отправить этот заголовок на другой server.
    Если Не ПустаяСтрока(Bearer) Тогда
        Запрос.Заголовки.Вставить("Authorization", "Bearer " + Bearer);
    КонецЕсли;

    Если Тело <> Неопределено Тогда
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(ЗначениеВJSON(Тело), КодировкаТекста.UTF8, Ложь);
    КонецЕсли;

    Попытка
        Соединение = НовоеHTTPSСоединение();
        Ответ = Соединение.ВызватьHTTPМетод(МетодВерх, Запрос);
    Исключение
        // Для POST неизвестно, успел ли сервер зафиксировать эффект до разрыва.
        // Поэтому никакого "успешно" здесь нет. Повтор решает слой idempotency /
        // reconciliation, а не сеть.
        Если МетодВерх = "POST" Тогда
            Возврат НовыйРезультатТранспорта("UNKNOWN_RESULT", 0, "NETWORK_AMBIGUOUS");
        Иначе
            Возврат НовыйРезультатТранспорта("TRANSIENT_FAILURE", 0, "NETWORK_FAILURE");
        КонецЕсли;
    КонецПопытки;

    КодHTTP = Ответ.КодСостояния;

    // Authorization нельзя унести redirect'ом. Мы не следуем Location.
    Если КодHTTP >= 300 И КодHTTP < 400 Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", КодHTTP, "REDIRECT_REFUSED");
    КонецЕсли;

    // Даже при Content-Length проверяем фактически прочитанную строку. 2 MiB —
    // жёсткий защитный потолок для control-plane ответа connector API.
    ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
    Если СтрДлина(ТелоОтвета) > 2097152 Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", КодHTTP, "RESPONSE_TOO_LARGE");
    КонецЕсли;

    Если КодHTTP = 429 Или КодHTTP >= 500 Тогда
        Возврат НовыйРезультатТранспорта("TRANSIENT_FAILURE", КодHTTP, "PROVIDER_TEMPORARY");
    КонецЕсли;

    Результат = НовыйРезультатТранспорта(
        ?(КодHTTP >= 200 И КодHTTP < 300, "HTTP_OK", "HTTP_REJECTED"),
        КодHTTP,
        ?(КодHTTP >= 200 И КодHTTP < 300, "", "REQUEST_REJECTED"));

    Если Не ПустаяСтрока(ТелоОтвета) Тогда
        Попытка
            Результат.Ответ = JSONВЗначение(ТелоОтвета);
        Исключение
            Результат.Состояние = "UNKNOWN_RESULT";
            Результат.Код = "INVALID_JSON_RESPONSE";
        КонецПопытки;
    КонецЕсли;

    Возврат Результат;
КонецФункции

Функция ВыполнитьPairing(ОдноразовыйКод, Discovery, CorrelationId = "") Экспорт
    Если ТипЗнч(ОдноразовыйКод) <> Тип("Строка")
        Или СтрДлина(СокрЛП(ОдноразовыйКод)) < 16 Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "PAIRING_CODE_INVALID");
    КонецЕсли;

    Тело = Новый Структура;
    Тело.Вставить("code", ОдноразовыйКод);
    Тело.Вставить("discovery", Discovery);

    // Pairing code не является долгоживущим bearer и никогда не кладётся в
    // Authorization header.
    Возврат ВыполнитьJSONЗапрос(
        "POST",
        БазовыйПуть + "/pair",
        Тело,
        "",
        CorrelationId);
КонецФункции

Функция ОтправитьHeartbeat(Bearer, Метаданные, CorrelationId = "") Экспорт
    Возврат ВыполнитьJSONЗапрос(
        "POST",
        БазовыйПуть + "/heartbeat",
        Метаданные,
        Bearer,
        CorrelationId);
КонецФункции

Функция ПолучитьЗадания(Bearer, CorrelationId = "") Экспорт
    Возврат ВыполнитьJSONЗапрос(
        "GET",
        БазовыйПуть + "/jobs",
        Неопределено,
        Bearer,
        CorrelationId);
КонецФункции

Функция ПодтвердитьЗадание(Bearer, JobId, LeaseBearer, CorrelationId) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("lease", LeaseBearer);
    Возврат ВыполнитьJSONЗапрос(
        "POST",
        БазовыйПуть + "/jobs/" + КодироватьСтроку(JobId, СпособКодированияСтроки.КодировкаURL) + "/ack",
        Тело,
        Bearer,
        CorrelationId);
КонецФункции

Функция ОтправитьРезультатЗадания(Bearer, JobId, LeaseBearer, ExternalEvidenceId, ResultCode, CorrelationId) Экспорт
    Если ПустаяСтрока(ExternalEvidenceId) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "EXTERNAL_EVIDENCE_REQUIRED");
    КонецЕсли;

    Тело = Новый Структура;
    Тело.Вставить("lease", LeaseBearer);
    Тело.Вставить("outcome", "REPORTED_SUCCESS");
    Тело.Вставить("externalEvidenceId", ExternalEvidenceId);
    Тело.Вставить("resultCode", ResultCode);

    Возврат ВыполнитьJSONЗапрос(
        "POST",
        БазовыйПуть + "/jobs/" + КодироватьСтроку(JobId, СпособКодированияСтроки.КодировкаURL) + "/result",
        Тело,
        Bearer,
        CorrelationId);
КонецФункции

Функция ОтправитьОтказЗадания(Bearer, JobId, LeaseBearer, Outcome, ResultCode, CorrelationId) Экспорт
    Если Outcome <> "BUSINESS_REJECTION" И Outcome <> "UNKNOWN_RESULT" Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "OUTCOME_REFUSED");
    КонецЕсли;

    Тело = Новый Структура;
    Тело.Вставить("lease", LeaseBearer);
    Тело.Вставить("outcome", Outcome);
    Тело.Вставить("resultCode", ResultCode);

    Возврат ВыполнитьJSONЗапрос(
        "POST",
        БазовыйПуть + "/jobs/" + КодироватьСтроку(JobId, СпособКодированияСтроки.КодировкаURL) + "/fail",
        Тело,
        Bearer,
        CorrelationId);
КонецФункции
