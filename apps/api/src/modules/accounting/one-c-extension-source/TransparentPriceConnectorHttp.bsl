// Прозрачная Цена — outbound-only transport connector protocol v1.
//
// Единственный сетевой контур этого общего модуля — исходящий HTTPS к
// compile-time закрепленному host. Здесь намеренно нет HTTP-сервиса, OData,
// произвольного URL, SQL, удаленного рабочего стола или входящего listener.
// Machine/lease bearer запрещено писать в журнал регистрации.

Перем СерверПлатформы Экспорт;
Перем БазовыйПуть Экспорт;

Процедура ИнициализироватьКонстанты() Экспорт
    СерверПлатформы = "xn----8sbjf4befbjgs9b.xn--p1ai";
    БазовыйПуть = "/connector/v1";
КонецПроцедуры

Функция НовоеHTTPSСоединение() Экспорт
    Если ПустаяСтрока(СерверПлатформы) Тогда
        ИнициализироватьКонстанты();
    КонецЕсли;
    ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(
        , Новый СертификатыУдостоверяющихЦентровОС);
    Возврат Новый HTTPСоединение(
        СерверПлатформы, 443, , , , 20, ЗащищенноеСоединение);
КонецФункции

Функция ДопустимыйПуть(Путь) Экспорт
    Если ТипЗнч(Путь) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Путь <> БазовыйПуть
        И Лев(Путь, СтрДлина(БазовыйПуть) + 1) <> БазовыйПуть + "/" Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрНайти(Путь, "://") > 0
        Или СтрНайти(Путь, "..") > 0
        Или СтрНайти(Путь, "\\") > 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция БезопасныйИдентификатор(Значение, МаксимальнаяДлина = 240) Экспорт
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если ПустаяСтрока(Значение) Или СтрДлина(Значение) > МаксимальнаяДлина Тогда
        Возврат "";
    КонецЕсли;
    Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789:_.@-";
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти(Допустимые, Сред(Значение, Номер, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция БезопасныйИдентификаторURL(Идентификатор) Экспорт
    Возврат БезопасныйИдентификатор(Идентификатор, 240);
КонецФункции

Функция БезопасныйCorrelationId(CorrelationId) Экспорт
    Если CorrelationId = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(CorrelationId) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(CorrelationId)) Тогда
        Возврат "";
    КонецЕсли;
    Результат = БезопасныйИдентификатор(CorrelationId, 128);
    Возврат ?(ПустаяСтрока(Результат), Неопределено, Результат);
КонецФункции

Функция БезопасныйBearerФормат(Bearer) Экспорт
    Если Bearer = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Bearer) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Bearer = СокрЛП(Bearer);
    Если ПустаяСтрока(Bearer) Тогда
        Возврат "";
    КонецЕсли;

    // UUID (36) + точка + 43 base64url-символа. CR/LF, пробел и иной
    // header alphabet отсекаются до создания HTTPЗапрос.
    Если СтрДлина(Bearer) <> 80 Или Сред(Bearer, 37, 1) <> "." Тогда
        Возврат Неопределено;
    КонецЕсли;
    UUID = Лев(Bearer, 36);
    Если Сред(UUID, 9, 1) <> "-"
        Или Сред(UUID, 14, 1) <> "-"
        Или Сред(UUID, 19, 1) <> "-"
        Или Сред(UUID, 24, 1) <> "-" Тогда
        Возврат Неопределено;
    КонецЕсли;
    ДопустимыеHex = "0123456789abcdefABCDEF";
    Для Номер = 1 По 36 Цикл
        Если Номер = 9 Или Номер = 14 Или Номер = 19 Или Номер = 24 Тогда
            Продолжить;
        КонецЕсли;
        Если СтрНайти(ДопустимыеHex, Сред(UUID, Номер, 1)) = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Секрет = Сред(Bearer, 38, 43);
    ДопустимыеBase64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-";
    Для Номер = 1 По СтрДлина(Секрет) Цикл
        Если СтрНайти(ДопустимыеBase64URL, Сред(Секрет, Номер, 1)) = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Возврат Bearer;
КонецФункции

Функция БезопасныйMachineBearer(Bearer) Экспорт
    Возврат БезопасныйBearerФормат(Bearer);
КонецФункции

Функция БезопасныйLeaseBearer(Bearer) Экспорт
    Возврат БезопасныйBearerФормат(Bearer);
КонецФункции

Функция БезопасныйPayloadHash(PayloadHash) Экспорт
    Если ТипЗнч(PayloadHash) <> Тип("Строка")
        Или СтрДлина(PayloadHash) <> 64 Тогда
        Возврат "";
    КонецЕсли;
    Допустимые = "0123456789abcdefABCDEF";
    Для Номер = 1 По 64 Цикл
        Если СтрНайти(Допустимые, Сред(PayloadHash, Номер, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;
    Возврат НРег(PayloadHash);
КонецФункции

Функция БезопасноеЦелое(Значение, Максимум) Экспорт
    Если ТипЗнч(Значение) <> Тип("Число")
        Или Значение < 0
        Или Значение > Максимум
        Или Цел(Значение) <> Значение Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция БезопасныйМашинныйКод(Код) Экспорт
    Если ТипЗнч(Код) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;
    Код = ВРег(СокрЛП(Код));
    Если ПустаяСтрока(Код) Или СтрДлина(Код) > 96 Тогда
        Возврат "";
    КонецЕсли;
    Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-";
    Для Номер = 1 По СтрДлина(Код) Цикл
        Если СтрНайти(Допустимые, Сред(Код, Номер, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;
    Возврат Код;
КонецФункции

Функция БезопасныйExternalEvidenceId(Идентификатор) Экспорт
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;
    Идентификатор = СокрЛП(Идентификатор);
    Если ПустаяСтрока(Идентификатор) Или СтрДлина(Идентификатор) > 240 Тогда
        Возврат "";
    КонецЕсли;
    Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789:_.@/-";
    Для Номер = 1 По СтрДлина(Идентификатор) Цикл
        Если СтрНайти(Допустимые, Сред(Идентификатор, Номер, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;
    Возврат Идентификатор;
КонецФункции

Функция ЗначениеВJSON(Значение) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция JSONВЗначение(СтрокаJSON) Экспорт
    Если ПустаяСтрока(СтрокаJSON) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция НовыйРезультатТранспорта(Состояние, КодHTTP = 0, Код = "")
    Результат = Новый Структура;
    Результат.Вставить("Состояние", Состояние);
    Результат.Вставить("КодHTTP", КодHTTP);
    Результат.Вставить("Код", Код);
    Результат.Вставить("Ответ", Неопределено);
    Возврат Результат;
КонецФункции

Функция ВыполнитьJSONЗапрос(Метод, Путь, Тело, Bearer, CorrelationId, LeaseBearer = "") Экспорт
    Если ПустаяСтрока(СерверПлатформы) Тогда
        ИнициализироватьКонстанты();
    КонецЕсли;
    Если Не ДопустимыйПуть(Путь) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "PATH_REFUSED");
    КонецЕсли;
    МетодВерх = ВРег(Метод);
    Если МетодВерх <> "GET" И МетодВерх <> "POST" Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "METHOD_REFUSED");
    КонецЕсли;

    БезопасныйCorrelation = БезопасныйCorrelationId(CorrelationId);
    Если БезопасныйCorrelation = Неопределено Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "CORRELATION_ID_REFUSED");
    КонецЕсли;
    БезопасныйBearer = БезопасныйMachineBearer(Bearer);
    Если БезопасныйBearer = Неопределено Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "BEARER_REFUSED");
    КонецЕсли;
    БезопасныйLease = БезопасныйLeaseBearer(LeaseBearer);
    Если БезопасныйLease = Неопределено Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "LEASE_BEARER_REFUSED");
    КонецЕсли;

    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Запрос.Заголовки.Вставить("X-PC-Connector-Protocol", "1");
    Запрос.Заголовки.Вставить("User-Agent", "TransparentPrice-1C-Connector/1");
    Если Не ПустаяСтрока(БезопасныйCorrelation) Тогда
        Запрос.Заголовки.Вставить("X-Correlation-Id", БезопасныйCorrelation);
    КонецЕсли;
    Если Не ПустаяСтрока(БезопасныйBearer) Тогда
        Запрос.Заголовки.Вставить("Authorization", "Bearer " + БезопасныйBearer);
    КонецЕсли;
    Если Не ПустаяСтрока(БезопасныйLease) Тогда
        Запрос.Заголовки.Вставить("X-One-C-Job-Lease", "Bearer " + БезопасныйLease);
    КонецЕсли;
    Если Тело <> Неопределено Тогда
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(ЗначениеВJSON(Тело), КодировкаТекста.UTF8, Ложь);
    КонецЕсли;

    Попытка
        Соединение = НовоеHTTPSСоединение();
        Ответ = Соединение.ВызватьHTTPМетод(МетодВерх, Запрос);
    Исключение
        Если МетодВерх = "POST" Тогда
            Возврат НовыйРезультатТранспорта("UNKNOWN_RESULT", 0, "NETWORK_AMBIGUOUS");
        Иначе
            Возврат НовыйРезультатТранспорта("TRANSIENT_FAILURE", 0, "NETWORK_FAILURE");
        КонецЕсли;
    КонецПопытки;

    КодHTTP = Ответ.КодСостояния;
    Если КодHTTP >= 300 И КодHTTP < 400 Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", КодHTTP, "REDIRECT_REFUSED");
    КонецЕсли;
    ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
    Если СтрДлина(ТелоОтвета) > 2097152 Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", КодHTTP, "RESPONSE_TOO_LARGE");
    КонецЕсли;
    Если КодHTTP = 429 Или КодHTTP >= 500 Тогда
        Возврат НовыйРезультатТранспорта("TRANSIENT_FAILURE", КодHTTP, "PROVIDER_TEMPORARY");
    КонецЕсли;

    Результат = НовыйРезультатТранспорта(
        ?(КодHTTP >= 200 И КодHTTP < 300, "HTTP_OK", "HTTP_REJECTED"),
        КодHTTP,
        ?(КодHTTP >= 200 И КодHTTP < 300, "", "REQUEST_REJECTED"));
    Если Не ПустаяСтрока(ТелоОтвета) Тогда
        Попытка
            Результат.Ответ = JSONВЗначение(ТелоОтвета);
        Исключение
            Результат.Состояние = "UNKNOWN_RESULT";
            Результат.Код = "INVALID_JSON_RESPONSE";
        КонецПопытки;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ВыполнитьPairing(ОдноразовыйКод, Discovery, CorrelationId = "") Экспорт
    Если ТипЗнч(ОдноразовыйКод) <> Тип("Строка")
        Или СтрДлина(СокрЛП(ОдноразовыйКод)) < 16
        Или СтрДлина(СокрЛП(ОдноразовыйКод)) > 256 Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "PAIRING_CODE_INVALID");
    КонецЕсли;
    Тело = Новый Структура;
    Тело.Вставить("code", ОдноразовыйКод);
    Тело.Вставить("discovery", Discovery);
    Возврат ВыполнитьJSONЗапрос("POST", БазовыйПуть + "/pair", Тело, "", CorrelationId);
КонецФункции

Функция ОтправитьHeartbeat(Bearer, Метаданные, CorrelationId = "") Экспорт
    БезопасныйBearer = БезопасныйMachineBearer(Bearer);
    Если БезопасныйBearer = Неопределено Или ПустаяСтрока(БезопасныйBearer) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "MACHINE_BEARER_REQUIRED");
    КонецЕсли;
    Возврат ВыполнитьJSONЗапрос(
        "POST", БазовыйПуть + "/heartbeat", Метаданные, Bearer, CorrelationId);
КонецФункции

Функция ПолучитьЗадания(Bearer, CorrelationId = "") Экспорт
    БезопасныйBearer = БезопасныйMachineBearer(Bearer);
    Если БезопасныйBearer = Неопределено Или ПустаяСтрока(БезопасныйBearer) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "MACHINE_BEARER_REQUIRED");
    КонецЕсли;
    Возврат ВыполнитьJSONЗапрос(
        "GET", БазовыйПуть + "/jobs", Неопределено, Bearer, CorrelationId);
КонецФункции

Функция НоваяКвитанция(IdempotencyKey, PayloadHash, Revision, Attempt) Экспорт
    БезопасныйКлюч = БезопасныйИдентификатор(IdempotencyKey, 240);
    БезопасныйHash = БезопасныйPayloadHash(PayloadHash);
    БезопаснаяРевизия = БезопасноеЦелое(Revision, 9007199254740991);
    БезопаснаяПопытка = БезопасноеЦелое(Attempt, 100);
    Если ПустаяСтрока(БезопасныйКлюч)
        Или ПустаяСтрока(БезопасныйHash)
        Или БезопаснаяРевизия = Неопределено
        Или БезопаснаяПопытка = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Тело = Новый Структура;
    Тело.Вставить("idempotencyKey", БезопасныйКлюч);
    Тело.Вставить("payloadHash", БезопасныйHash);
    Тело.Вставить("revision", БезопаснаяРевизия);
    Тело.Вставить("attempt", БезопаснаяПопытка);
    Возврат Тело;
КонецФункции

Функция ПодтвердитьЗадание(Bearer, JobId, LeaseBearer, IdempotencyKey, PayloadHash, Revision, Attempt, CorrelationId) Экспорт
    БезопасныйJobId = БезопасныйИдентификаторURL(JobId);
    БезопасныйLease = БезопасныйLeaseBearer(LeaseBearer);
    Тело = НоваяКвитанция(IdempotencyKey, PayloadHash, Revision, Attempt);
    Если ПустаяСтрока(БезопасныйJobId) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "JOB_ID_REFUSED");
    ИначеЕсли ПустаяСтрока(БезопасныйLease) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "LEASE_BEARER_REQUIRED");
    ИначеЕсли Тело = Неопределено Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "RECEIPT_ENVELOPE_REFUSED");
    КонецЕсли;
    Возврат ВыполнитьJSONЗапрос(
        "POST", БазовыйПуть + "/jobs/" + БезопасныйJobId + "/ack",
        Тело, Bearer, CorrelationId, БезопасныйLease);
КонецФункции

Функция ОтправитьРезультатЗадания(Bearer, JobId, LeaseBearer, IdempotencyKey, PayloadHash, Revision, Attempt, ResultState, ExternalEvidenceId, ResultCode, CorrelationId) Экспорт
    БезопасныйJobId = БезопасныйИдентификаторURL(JobId);
    БезопасныйLease = БезопасныйLeaseBearer(LeaseBearer);
    Тело = НоваяКвитанция(IdempotencyKey, PayloadHash, Revision, Attempt);
    БезопасныйResultCode = БезопасныйМашинныйКод(ResultCode);
    БезопасныйEvidence = БезопасныйExternalEvidenceId(ExternalEvidenceId);
    Если ПустаяСтрока(БезопасныйJobId) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "JOB_ID_REFUSED");
    ИначеЕсли ПустаяСтрока(БезопасныйLease) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "LEASE_BEARER_REQUIRED");
    ИначеЕсли Тело = Неопределено Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "RECEIPT_ENVELOPE_REFUSED");
    ИначеЕсли ResultState <> "CREATED_IN_1C" И ResultState <> "POSTED" Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "RESULT_STATE_REFUSED");
    ИначеЕсли ПустаяСтрока(БезопасныйResultCode) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "RESULT_CODE_REFUSED");
    ИначеЕсли ПустаяСтрока(БезопасныйEvidence) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "EXTERNAL_EVIDENCE_REQUIRED");
    КонецЕсли;
    Тело.Вставить("resultState", ResultState);
    Тело.Вставить("resultCode", БезопасныйResultCode);
    Тело.Вставить("externalEvidenceId", БезопасныйEvidence);
    Возврат ВыполнитьJSONЗапрос(
        "POST", БазовыйПуть + "/jobs/" + БезопасныйJobId + "/result",
        Тело, Bearer, CorrelationId, БезопасныйLease);
КонецФункции

Функция ДопустимыйКлассОтказа(КлассОтказа) Экспорт
    Возврат КлассОтказа = "TRANSIENT_NETWORK"
        Или КлассОтказа = "TRANSIENT_TIMEOUT"
        Или КлассОтказа = "TRANSIENT_RATE_LIMIT"
        Или КлассОтказа = "TRANSIENT_PROVIDER_5XX"
        Или КлассОтказа = "BUSINESS_REJECTION"
        Или КлассОтказа = "AUTHORIZATION_REJECTED"
        Или КлассОтказа = "PAYLOAD_INVALID"
        Или КлассОтказа = "PAYLOAD_HASH_MISMATCH"
        Или КлассОтказа = "STALE_REVISION"
        Или КлассОтказа = "UNKNOWN_RESULT"
        Или КлассОтказа = "SECURITY_HOLD";
КонецФункции

Функция ОтправитьОтказЗадания(Bearer, JobId, LeaseBearer, IdempotencyKey, PayloadHash, Revision, Attempt, FailureClass, EffectState, ResultCode, CorrelationId) Экспорт
    БезопасныйJobId = БезопасныйИдентификаторURL(JobId);
    БезопасныйLease = БезопасныйLeaseBearer(LeaseBearer);
    Тело = НоваяКвитанция(IdempotencyKey, PayloadHash, Revision, Attempt);
    БезопасныйResultCode = БезопасныйМашинныйКод(ResultCode);
    Если ПустаяСтрока(БезопасныйJobId) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "JOB_ID_REFUSED");
    ИначеЕсли ПустаяСтрока(БезопасныйLease) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "LEASE_BEARER_REQUIRED");
    ИначеЕсли Тело = Неопределено Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "RECEIPT_ENVELOPE_REFUSED");
    ИначеЕсли Не ДопустимыйКлассОтказа(FailureClass) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "FAILURE_CLASS_REFUSED");
    ИначеЕсли EffectState <> "CONFIRMED_NO_EFFECT" И EffectState <> "UNKNOWN" Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "EFFECT_STATE_REFUSED");
    ИначеЕсли FailureClass = "UNKNOWN_RESULT" И EffectState <> "UNKNOWN" Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "EFFECT_STATE_REFUSED");
    ИначеЕсли ПустаяСтрока(БезопасныйResultCode) Тогда
        Возврат НовыйРезультатТранспорта("SECURITY_HOLD", 0, "RESULT_CODE_REFUSED");
    КонецЕсли;
    Тело.Вставить("failureClass", FailureClass);
    Тело.Вставить("effectState", EffectState);
    Тело.Вставить("resultCode", БезопасныйResultCode);
    Возврат ВыполнитьJSONЗапрос(
        "POST", БазовыйПуть + "/jobs/" + БезопасныйJobId + "/fail",
        Тело, Bearer, CorrelationId, БезопасныйLease);
КонецФункции
