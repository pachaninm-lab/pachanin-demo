// ── Gekta: аккаунт, доступ, история и монетизация ─────────────────────────────
//
// Гекта переиспользует существующую identity: аккаунт Гекты — это состояние
// поверх User платформы, а не вторая система аутентификации. Email verification,
// пароль/сессия и MFA остаются authority аккаунта.

enum GektaPhoneState {
  DECLARED
  VERIFIED
  CONFLICTED
  REVOKED
}

enum GektaGrantKind {
  MANUAL
  LIFETIME
  TRIAL_EXTENSION
}

enum GektaSubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum GektaPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum GektaReceiptState {
  NOT_REQUIRED
  PENDING
  ISSUED
  CANCELLED
  FAILED
}

enum GektaConsentPurpose {
  SERVICE_TERMS
  PERSONAL_DATA
  MARKETING
  SUPPORT_ACCESS
  SUBSCRIPTION_TERMS
  AUTO_RENEWAL
}

/// Состояние доступа пользователя к Гекте. Пробный период выдаётся один раз на
/// аккаунт, поэтому очистка cookie, смена браузера и повторный вход его не
/// возобновляют.
model GektaAccount {
  id             String    @id @default(cuid())
  userId         String    @unique(map: "gekta_accounts_user_key")
  trialStartedAt DateTime? @db.Timestamptz(6)
  trialEndsAt    DateTime? @db.Timestamptz(6)
  /// Пробный период уже выдавался: повторная выдача запрещена независимо от того,
  /// закончился он или был продлён.
  trialGranted   Boolean   @default(false)
  lifetimeAccess Boolean   @default(false)
  suspended      Boolean   @default(false)
  suspendedAt    DateTime? @db.Timestamptz(6)
  suspendReason  String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_accounts_user_fk")
  phoneIdentity GektaPhoneIdentity?
  usage         GektaUsage?
  subscription  GektaSubscription?
  grants        GektaEntitlementGrant[]
  projects      GektaProject[]
  conversations GektaConversation[]
  consents      GektaConsent[]
  supportGrants GektaSupportGrant[]
  payments      GektaPayment[]
  audits        GektaOperatorAudit[]

  @@index([trialEndsAt], map: "gekta_accounts_trial_ends_idx")
  @@index([createdAt], map: "gekta_accounts_created_idx")
  @@map("gekta_accounts")
}

/// Телефон обязателен как атрибут аккаунта. Канонический номер хранится
/// зашифрованным, а поиск идёт по отдельному HMAC-индексу: компрометация индекса
/// не раскрывает номера, а по шифротексту нельзя искать.
model GektaPhoneIdentity {
  id             String          @id @default(cuid())
  accountId      String          @unique(map: "gekta_phone_identities_account_key")
  /// AES-256-GCM шифротекст канонического E.164.
  encryptedPhone String          @db.VarChar(512)
  /// Детерминированный HMAC для точного совпадения. Частичный поиск невозможен.
  lookupHash     String          @db.VarChar(64)
  state          GektaPhoneState @default(DECLARED)
  declaredAt     DateTime        @default(now()) @db.Timestamptz(6)
  verifiedAt     DateTime?       @db.Timestamptz(6)
  revokedAt      DateTime?       @db.Timestamptz(6)
  /// Канал, которым владение было подтверждено. Пусто, пока подтверждения нет.
  verifiedVia    String?         @db.VarChar(64)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  account GektaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_phone_identities_account_fk")

  /// Неподтверждённый номер намеренно НЕ уникален: иначе первый заявивший навсегда
  /// блокировал бы чужой номер. Уникальность подтверждённого обеспечивается
  /// частичным индексом в миграции.
  @@index([lookupHash], map: "gekta_phone_identities_lookup_idx")
  @@index([state], map: "gekta_phone_identities_state_idx")
  @@map("gekta_phone_identities")
}

/// Счётчик завершённых ответов. Считаются именно завершённые ответы, а не
/// нажатия Send.
model GektaUsage {
  id               String    @id @default(cuid())
  accountId        String    @unique(map: "gekta_usage_account_key")
  completedAnswers BigInt    @default(0)
  answersToday     Int       @default(0)
  todayResetAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastAnswerAt     DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  account GektaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_usage_account_fk")

  @@map("gekta_usage")
}

/// Ручной доступ, выданный владельцем. Гранты не перезаписываются: отзыв — это
/// новое состояние существующей записи, а история остаётся целиком.
model GektaEntitlementGrant {
  id        String         @id @default(cuid())
  accountId String
  kind      GektaGrantKind
  grantedAt DateTime       @default(now()) @db.Timestamptz(6)
  /// Пусто у бессрочного доступа.
  expiresAt DateTime?      @db.Timestamptz(6)
  revokedAt DateTime?      @db.Timestamptz(6)
  grantedBy String         @db.VarChar(64)
  revokedBy String?        @db.VarChar(64)
  reason    String         @db.VarChar(500)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  account GektaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_entitlement_grants_account_fk")

  @@index([accountId, revokedAt, expiresAt], map: "gekta_entitlement_grants_active_idx")
  @@map("gekta_entitlement_grants")
}

model GektaProject {
  id          String    @id @default(cuid())
  accountId   String
  name        String    @db.VarChar(60)
  description String    @default("") @db.VarChar(240)
  locale      String    @db.VarChar(8)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  account       GektaAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_projects_account_fk")
  conversations GektaConversation[]

  @@index([accountId, deletedAt, updatedAt(sort: Desc)], map: "gekta_projects_account_idx")
  @@map("gekta_projects")
}

model GektaConversation {
  id         String    @id @default(cuid())
  accountId  String
  projectId  String?
  title      String    @db.VarChar(80)
  locale     String    @db.VarChar(8)
  /// Диалог, импортированный из анонимной истории при регистрации.
  importedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  account  GektaAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_conversations_account_fk")
  project  GektaProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "gekta_conversations_project_fk")
  messages GektaMessage[]

  @@index([accountId, deletedAt, updatedAt(sort: Desc)], map: "gekta_conversations_account_idx")
  @@index([projectId], map: "gekta_conversations_project_idx")
  @@map("gekta_conversations")
}

model GektaMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   @db.VarChar(16)
  body           String
  /// Подтверждённые источники ответа, если они были.
  citations      Json?
  attachments    Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  conversation GektaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_messages_conversation_fk")

  @@index([conversationId, createdAt], map: "gekta_messages_conversation_idx")
  @@map("gekta_messages")
}

/// Согласия по целям. Одно согласие — одна цель: 152-ФЗ требует конкретного,
/// предметного и однозначного согласия, оформленного отдельно от иных документов.
model GektaConsent {
  id              String              @id @default(cuid())
  accountId       String?
  /// Идентификатор анонимной сессии до регистрации.
  anonymousSid    String?             @db.VarChar(64)
  purpose         GektaConsentPurpose
  documentSlug    String              @db.VarChar(128)
  documentVersion String              @db.VarChar(32)
  locale          String              @db.VarChar(8)
  acceptedAt      DateTime            @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime?           @db.Timestamptz(6)
  /// Экран, на котором согласие было дано.
  sourceSurface   String              @db.VarChar(64)

  account GektaAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_consents_account_fk")

  @@index([accountId, purpose, acceptedAt(sort: Desc)], map: "gekta_consents_account_idx")
  @@index([anonymousSid], map: "gekta_consents_anonymous_idx")
  @@map("gekta_consents")
}

/// Разрешение поддержке читать диалоги, выданное самим пользователем и
/// ограниченное по времени. Без действующего гранта переписку не читает никто.
model GektaSupportGrant {
  id        String    @id @default(cuid())
  accountId String
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  reason    String    @db.VarChar(500)

  account GektaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_support_grants_account_fk")

  @@index([accountId, expiresAt(sort: Desc)], map: "gekta_support_grants_account_idx")
  @@map("gekta_support_grants")
}

/// Неизменяемый журнал действий оператора. Телефон попадает сюда только
/// маскированным и только как локатор поиска.
model GektaOperatorAudit {
  id                 String    @id @default(cuid())
  correlationId      String    @db.VarChar(64)
  actorUserId        String    @db.VarChar(64)
  actorRoles         String    @db.VarChar(200)
  accountId          String?
  phoneLocatorMasked String?   @db.VarChar(32)
  action             String    @db.VarChar(64)
  previousState      String    @db.VarChar(64)
  newState           String    @db.VarChar(64)
  reason             String    @db.VarChar(500)
  expiresAt          DateTime? @db.Timestamptz(6)
  source             String    @db.VarChar(64)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  account GektaAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "gekta_operator_audits_account_fk")

  @@index([accountId, createdAt(sort: Desc)], map: "gekta_operator_audits_account_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "gekta_operator_audits_actor_idx")
  @@index([correlationId], map: "gekta_operator_audits_correlation_idx")
  @@map("gekta_operator_audits")
}

/// Подписка. Отзыв платёжного средства фиксируется отдельным полем: после него
/// периодическое списание запрещено (ст. 16-1 ЗоЗПП в редакции 376-ФЗ).
model GektaSubscription {
  id                         String                  @id @default(cuid())
  accountId                  String                  @unique(map: "gekta_subscriptions_account_key")
  plan                       String                  @default("monthly") @db.VarChar(32)
  status                     GektaSubscriptionStatus @default(NONE)
  startedAt                  DateTime?               @db.Timestamptz(6)
  currentPeriodStart         DateTime?               @db.Timestamptz(6)
  currentPeriodEnd           DateTime?               @db.Timestamptz(6)
  cancelAtPeriodEnd          Boolean                 @default(false)
  cancelledAt                DateTime?               @db.Timestamptz(6)
  paymentMethodAuthorization String?                 @db.VarChar(255)
  paymentMethodRevokedAt     DateTime?               @db.Timestamptz(6)
  createdAt                  DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(6)

  account GektaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gekta_subscriptions_account_fk")

  @@index([status, currentPeriodEnd], map: "gekta_subscriptions_status_idx")
  @@map("gekta_subscriptions")
}

/// Платёж вместе со снимком продавца на момент оплаты: смена юридической формы
/// не переписывает историю расчётов.
model GektaPayment {
  id                String             @id @default(cuid())
  accountId         String
  provider          String             @db.VarChar(64)
  providerPaymentId String?            @db.VarChar(128)
  amountKopecks     Int
  currency          String             @default("RUB") @db.VarChar(3)
  status            GektaPaymentStatus @default(PENDING)
  idempotencyKey    String             @unique(map: "gekta_payments_idempotency_key") @db.VarChar(128)
  receiptState      GektaReceiptState  @default(NOT_REQUIRED)
  receiptId         String?            @db.VarChar(128)
  receiptUrl        String?            @db.VarChar(512)
  merchantSnapshot  Json
  paidAt            DateTime?          @db.Timestamptz(6)
  refundedAt        DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  account GektaAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gekta_payments_account_fk")

  @@index([accountId, createdAt(sort: Desc)], map: "gekta_payments_account_idx")
  @@index([status, createdAt(sort: Desc)], map: "gekta_payments_status_idx")
  @@map("gekta_payments")
}

/// Обработанные webhook-события. Существование записи — защита от повторного
/// применения одного и того же события.
model GektaWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @db.VarChar(64)
  eventId     String    @db.VarChar(128)
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  outcome     String    @db.VarChar(64)

  @@unique([provider, eventId], map: "gekta_webhook_events_provider_event_key")
  @@map("gekta_webhook_events")
}

/// Версионируемый профиль продавца. Переход НПД → ИП → ООО добавляет версию и
/// не требует миграции аккаунтов, подписок или entitlement.
model GektaMerchantProfile {
  id               String    @id @default(cuid())
  operatorType     String    @db.VarChar(32)
  legalDisplayName String    @db.VarChar(255)
  fullName         String?   @db.VarChar(255)
  inn              String?   @db.VarChar(12)
  ogrnip           String?   @db.VarChar(15)
  ogrn             String?   @db.VarChar(13)
  legalAddress     String?   @db.VarChar(500)
  contactAddress   String?   @db.VarChar(500)
  supportEmail     String?   @db.VarChar(255)
  supportPhone     String?   @db.VarChar(32)
  taxRegime        String    @db.VarChar(16)
  receiptMode      String    @db.VarChar(16)
  paymentProvider  String?   @db.VarChar(64)
  billingEnabled   Boolean   @default(false)
  verifiedAt       DateTime? @db.Timestamptz(6)
  source           String?   @db.VarChar(255)
  effectiveFrom    DateTime  @db.Timestamptz(6)
  effectiveTo      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([effectiveFrom(sort: Desc)], map: "gekta_merchant_profiles_effective_idx")
  @@map("gekta_merchant_profiles")
}
