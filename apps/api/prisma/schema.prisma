  @@index([sellerOrgId])
  @@index([buyerOrgId])
  @@index([status])
  @@index([tenantId])
  @@map("deals")
}

model DealParticipant {
  id               String    @id @default(cuid())
  dealId           String
  tenantId         String
  organizationId   String
