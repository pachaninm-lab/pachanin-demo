  hash      String
  prevHash  String?
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@index([dealId, createdAt], map: "deal_events_deal_created_idx")
  @@map("deal_events")
}

