// GrainFlow v3 — production persistence layer (PostgreSQL 16)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organizations & Users ─────────────────────────────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  inn         String    @unique
  ogrn        String?
  kpp         String?
  region      String?
  version     BigInt    @default(0)
  name        String
  type        String    @default("LEGAL")
  status      String    @default("PENDING")
  tenantId    String    @default(cuid())
  verifiedAt  DateTime?
  bankDetails String?
  address     String?
  kycStatus   String    @default("PENDING")
  amlStatus   String    @default("CLEAR")
  sanctionHit Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users                             UserOrg[]
  dealParticipants                  DealParticipant[]
  regulatoryIntegrationInboxEntries RegulatoryIntegrationInboxEntry[]
  fgisGrainProviderConfigurations   FgisGrainProviderConfiguration[]
  fgisGrainProviderAttestations     FgisGrainProviderAttestation[]
  fgisGrainTenantReadAuthorizations FgisGrainTenantReadAuthorization[]
  fgisGrainTenantReadProviderClaims FgisGrainTenantReadProviderClaim[]
  fgisGrainTenantReadAudits         FgisGrainTenantReadAudit[]
  fgisGrainTenantReadAuditHeads     FgisGrainTenantReadAuditHead[]
  fgisGrainSdizProjectionBatches    FgisGrainSdizProjectionBatch[]
  fgisGrainSdizProjections          FgisGrainSdizProjection[]
  fgisGrainExchanges                FgisGrainExchange[]
  fgisGrainAcknowledgements         FgisGrainAcknowledgement[]
  membershipDelegations             MembershipDelegation[]
  signingAuthorities                SigningAuthority[]
  accountingDocuments               AccountingDocument[]
  accountingDocumentVersions        AccountingDocumentVersion[]
  accountingNumberCounters          AccountingNumberCounter[]
  taxProfiles                       OrganizationTaxProfile[]
  contractVersions                  ContractVersion[]
  accountingWorkTasks               AccountingWorkTask[]
  accountingPeriods                 AccountingPeriod[]
  accountingAdvances                AccountingAdvance[]
  accountingAdvanceOffsets          AccountingAdvanceOffset[]
  accountingDealServices            AccountingDealService[]
  accountingPayments                AccountingPayment[]
  accountingPaymentAllocations      AccountingPaymentAllocation[]
  accountingReconciliations         AccountingReconciliation[]
  connectionAttestationSubjects     ConnectionAttestationSubject[]
  capabilityAssignments             OrganizationCapabilityAssignment[]
  capabilityEvents                  OrganizationCapabilityEvent[]
  providers                         Provider[]
  providerRegistryEvents            ProviderRegistryEvent[]
  integrationBindings               IntegrationBinding[]
  integrationBindingEvents          IntegrationBindingEvent[]
  commercialRuleSets                CommercialRuleSet[]
  commercialRulePacks               CommercialRulePack[]
  commercialDecisions               CommercialDecision[]
  commercialRuleEvents              CommercialRuleEvent[]

  @@unique([id, tenantId], map: "organizations_id_tenant_id_identity_idx")
  @@index([tenantId])
  @@index([inn])
  @@map("organizations")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  passwordHash String
  fullName     String
  status       String    @default("ACTIVE")
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  mfaBackup    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orgs                              UserOrg[]
  ukepCerts                         UkepCertificate[]
  dealParticipants                  DealParticipant[]
  fgisProviderConfigurationsCreated FgisGrainProviderConfiguration[] @relation("FgisProviderConfigurationCreatedBy")
  fgisProviderConfigurationsUpdated FgisGrainProviderConfiguration[] @relation("FgisProviderConfigurationUpdatedBy")
  fgisGrainProviderAttestations     FgisGrainProviderAttestation[]
  fgisGrainTenantReadAuthorizationsCreated  FgisGrainTenantReadAuthorization[] @relation("FgisGrainTenantReadAuthorizationCreatedBy")
  fgisGrainTenantReadAuthorizationsUpdated  FgisGrainTenantReadAuthorization[] @relation("FgisGrainTenantReadAuthorizationUpdatedBy")
  fgisGrainTenantReadAuthorizationsAttested FgisGrainTenantReadAuthorization[] @relation("FgisGrainTenantReadAuthorizationAttestedBy")
  fgisGrainTenantReadProviderClaims          FgisGrainTenantReadProviderClaim[]  @relation("FgisGrainTenantReadProviderClaimActor")
  fgisGrainTenantReadAudits                  FgisGrainTenantReadAudit[]         @relation("FgisGrainTenantReadAuditActor")
  gektaAccount                               GektaAccount?

  @@map("users")
}

model UserOrg {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role               String
  /// Second axis alongside `role`. `role` keeps its market meaning — including
  /// ACCOUNTING, which is the bank/settlement actor — while `jobProfile` says
  /// what the person does inside the organization. A bookkeeper is expected to
  /// be `role = GUEST` with `jobProfile = ACCOUNTANT`.
  jobProfile         String?   @map("job_profile")
  status             String    @default("ACTIVE")
  requestedWorkspace String?   @map("requested_workspace")
  isDefault          Boolean   @default(false)
  isOrgAdmin         Boolean   @default(false) @map("is_org_admin")
  joinedAt           DateTime  @default(now())
  activatedAt        DateTime? @map("activated_at")
  revokedAt          DateTime? @map("revoked_at")
  version            BigInt    @default(0)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  delegationsGranted  MembershipDelegation[] @relation("MembershipDelegationFrom")
  delegationsReceived MembershipDelegation[] @relation("MembershipDelegationTo")
  signingAuthorities  SigningAuthority[] @relation("SigningAuthorityHolder")
  signingAuthoritiesApproved SigningAuthority[] @relation("SigningAuthoritySecondApprover")
  accountingDocumentsAuthored AccountingDocument[]        @relation("AccountingDocumentAuthor")
  accountingVersionsAuthored  AccountingDocumentVersion[] @relation("AccountingDocumentVersionAuthor")
  accountingVersionsSigned    AccountingDocumentVersion[] @relation("AccountingDocumentVersionSigner")
  taxProfilesAuthored         OrganizationTaxProfile[]    @relation("OrganizationTaxProfileAuthor")
  contractVersionsAuthored    ContractVersion[]           @relation("ContractVersionAuthor")
  contractVersionsSigned      ContractVersion[]           @relation("ContractVersionSigner")
  workTasksAssigned           AccountingWorkTask[]        @relation("AccountingWorkTaskAssignee")
  workTasksAuthored           AccountingWorkTask[]        @relation("AccountingWorkTaskAuthor")
  workTasksResolved           AccountingWorkTask[]        @relation("AccountingWorkTaskResolver")
  periodsOpened               AccountingPeriod[]          @relation("AccountingPeriodOpener")
  periodsClosed               AccountingPeriod[]          @relation("AccountingPeriodCloser")
  advancesRecorded            AccountingAdvance[]         @relation("AccountingAdvanceRecorder")
  advanceOffsetsApplied       AccountingAdvanceOffset[]   @relation("AccountingAdvanceOffsetActor")
  dealServicesRecorded        AccountingDealService[]     @relation("AccountingDealServiceRecorder")
  dealServicesApproved        AccountingDealService[]     @relation("AccountingDealServiceApprover")
  paymentsRecorded            AccountingPayment[]         @relation("AccountingPaymentRecorder")
  paymentAllocationsMade      AccountingPaymentAllocation[] @relation("AccountingPaymentAllocationActor")
  reconciliationsPrepared     AccountingReconciliation[]  @relation("AccountingReconciliationPreparer")
  reconciliationsAnswered     AccountingReconciliation[]  @relation("AccountingReconciliationResponder")
  connectionSubjectsCreated   ConnectionAttestationSubject[] @relation("ConnectionAttestationSubjectAuthor")
  capabilityAssignmentsCreated OrganizationCapabilityAssignment[] @relation("OrganizationCapabilityCreatedBy")
  capabilityAssignmentsUpdated OrganizationCapabilityAssignment[] @relation("OrganizationCapabilityUpdatedBy")
  capabilityEventsAuthored      OrganizationCapabilityEvent[]      @relation("OrganizationCapabilityEventActor")
  providersCreated              Provider[]                          @relation("ProviderCreatedBy")
  providersUpdated              Provider[]                          @relation("ProviderUpdatedBy")
  providerCapabilitiesCreated   ProviderCapability[]                @relation("ProviderCapabilityCreatedBy")
  providerCapabilitiesUpdated   ProviderCapability[]                @relation("ProviderCapabilityUpdatedBy")
  serviceOfferingsCreated       ServiceOffering[]                   @relation("ServiceOfferingCreatedBy")
  serviceOfferingsUpdated       ServiceOffering[]                   @relation("ServiceOfferingUpdatedBy")
  providerRegistryEventsAuthored ProviderRegistryEvent[]            @relation("ProviderRegistryEventActor")
  integrationBindingsCreated     IntegrationBinding[]                @relation("IntegrationBindingCreatedBy")
  integrationBindingsUpdated     IntegrationBinding[]                @relation("IntegrationBindingUpdatedBy")
  integrationBindingEventsAuthored IntegrationBindingEvent[]         @relation("IntegrationBindingEventActor")
  commercialRuleSetsCreated      CommercialRuleSet[]                  @relation("CommercialRuleSetCreatedBy")
  commercialRuleSetsUpdated      CommercialRuleSet[]                  @relation("CommercialRuleSetUpdatedBy")
  commercialRulePacksCreated     CommercialRulePack[]                 @relation("CommercialRulePackCreatedBy")
  commercialRulePacksUpdated     CommercialRulePack[]                 @relation("CommercialRulePackUpdatedBy")
  commercialDecisionsAuthored    CommercialDecision[]                 @relation("CommercialDecisionActor")
  commercialRuleEventsAuthored   CommercialRuleEvent[]                @relation("CommercialRuleEventActor")

  @@unique([userId, organizationId])
  @@unique([id, organizationId], map: "user_orgs_id_organization_identity_idx")
  @@index([organizationId])
  @@index([organizationId, jobProfile])
  @@map("user_orgs")
}

/// Server-authoritative declaration of what one organization can do. W1-A is
/// deliberately shadow-only: downstream Auction, Deal and Settlement policy
/// does not consume these rows until a later, separately accepted slice.
model OrganizationCapabilityAssignment {
  id                    String    @id
  tenantId              String
  organizationId        String
  capabilityCode        String
  status                String
  requiresVerification  Boolean
  provenance            String    @default("SELF_DECLARED")
  evidenceReference     String?
  effectiveFrom         DateTime? @db.Timestamptz(6)
  effectiveTo           DateTime? @db.Timestamptz(6)
  version               BigInt    @default(1)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "organization_capability_organization_fkey")
  createdBy    UserOrg      @relation("OrganizationCapabilityCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "organization_capability_created_by_fkey")
  updatedBy    UserOrg      @relation("OrganizationCapabilityUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "organization_capability_updated_by_fkey")
  events       OrganizationCapabilityEvent[]

  @@unique([organizationId, capabilityCode], map: "organization_capability_org_code_key")
  @@unique([id, tenantId, organizationId], map: "organization_capability_identity_key")
  @@index([tenantId, organizationId, status], map: "organization_capability_scope_status_idx")
  @@map("organization_capability_assignments")
}

/// Append-only command receipt and hash chain for capability declarations.
/// auditEventId and outboxEntryId identify records committed in the same SQL
/// transaction; they intentionally remain scalar to avoid coupling generic
/// audit/outbox retention to this bounded aggregate.
model OrganizationCapabilityEvent {
  id                 String   @id
  tenantId           String
  organizationId     String
  assignmentId       String
  commandId          String
  idempotencyKey     String
  requestFingerprint String
  action             String
  fromStatus         String?
  toStatus           String
  reason             String
  actorUserId        String
  actorRole          String
  actorMembershipId  String
  correlationId      String
  prevHash           String?
  hash               String
  auditEventId       String   @unique(map: "organization_capability_event_audit_key")
  outboxEntryId      String   @unique(map: "organization_capability_event_outbox_key")
  aggregateVersion   BigInt
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  assignment   OrganizationCapabilityAssignment @relation(fields: [assignmentId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "organization_capability_event_assignment_fkey")
  organization Organization                     @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "organization_capability_event_organization_fkey")
  actor        UserOrg                          @relation("OrganizationCapabilityEventActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "organization_capability_event_actor_fkey")

  @@unique([tenantId, organizationId, idempotencyKey], map: "organization_capability_event_idempotency_key")
  @@unique([tenantId, organizationId, commandId], map: "organization_capability_event_command_key")
  @@index([assignmentId, createdAt, id], map: "organization_capability_event_chain_idx")
  @@index([tenantId, organizationId, createdAt], map: "organization_capability_event_scope_idx")
  @@map("organization_capability_events")
}

/// Durable provider identity owned by one organization. Application users can
/// create only PENDING_VERIFICATION profiles; activation belongs to a separate
/// staff-verification authority and is intentionally absent from W1-B.
model Provider {
  id                    String   @id
  tenantId              String
  organizationId        String
  status                String   @default("PENDING_VERIFICATION")
  version               BigInt   @default(1)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "provider_organization_fkey")
  createdBy    UserOrg      @relation("ProviderCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "provider_created_by_fkey")
  updatedBy    UserOrg      @relation("ProviderUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "provider_updated_by_fkey")
  capabilities ProviderCapability[]
  events       ProviderRegistryEvent[]
  integrationBindings IntegrationBinding[]

  @@unique([organizationId], map: "provider_organization_key")
  @@unique([id, tenantId, organizationId], map: "provider_scope_identity_key")
  @@index([tenantId, status], map: "provider_tenant_status_idx")
  @@map("providers")
}

/// A server-controlled declaration that a provider can offer one category.
/// Self-declarations remain PENDING_VERIFICATION and are never catalog-visible.
model ProviderCapability {
  id                    String    @id
  tenantId              String
  organizationId        String
  providerId            String
  category              String
  legalRole             String
  status                String    @default("PENDING_VERIFICATION")
  version               BigInt    @default(1)
  effectiveFrom         DateTime? @db.Timestamptz(6)
  effectiveTo           DateTime? @db.Timestamptz(6)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  provider   Provider @relation(fields: [providerId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "provider_capability_provider_fkey")
  createdBy  UserOrg  @relation("ProviderCapabilityCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "provider_capability_created_by_fkey")
  updatedBy  UserOrg  @relation("ProviderCapabilityUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "provider_capability_updated_by_fkey")
  offerings  ServiceOffering[]
  evidence   ProviderRegistryEvidence[]
  integrationBindings IntegrationBinding[]

  @@unique([providerId, category], map: "provider_capability_category_key")
  @@unique([id, tenantId, organizationId], map: "provider_capability_scope_identity_key")
  @@unique([id, providerId, tenantId, organizationId], map: "provider_capability_evidence_identity_key")
  @@unique([id, tenantId, organizationId, category], map: "provider_capability_service_identity_key")
  @@unique([id, providerId, tenantId, organizationId, category], map: "provider_capability_full_identity_key")
  @@unique([providerId, tenantId, organizationId, category], map: "provider_capability_offering_identity_key")
  @@index([tenantId, category, status], map: "provider_capability_catalog_idx")
  @@map("provider_capabilities")
}

/// Searchable service definition. Only separately verified ACTIVE rows enter
/// catalog and recommendation reads; W1-B organization commands write pending.
model ServiceOffering {
  id                    String   @id
  tenantId              String
  organizationId        String
  providerId            String
  capabilityId          String
  offeringKey           String
  category              String
  title                 String
  description           String
  regions               String[]
  cultures              String[]
  stages                String[]
  status                String   @default("PENDING_VERIFICATION")
  version               BigInt   @default(1)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  capability ProviderCapability @relation(fields: [capabilityId, providerId, tenantId, organizationId, category], references: [id, providerId, tenantId, organizationId, category], onDelete: Restrict, map: "service_offering_capability_fkey")
  createdBy  UserOrg            @relation("ServiceOfferingCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "service_offering_created_by_fkey")
  updatedBy  UserOrg            @relation("ServiceOfferingUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "service_offering_updated_by_fkey")

  @@unique([providerId, offeringKey], map: "service_offering_provider_key")
  @@unique([id, tenantId, organizationId], map: "service_offering_scope_identity_key")
  @@index([tenantId, category, status], map: "service_offering_catalog_idx")
  @@map("service_offerings")
}

/// Provider-neutral transport configuration for one provider capability.
/// Organization commands may declare references, never secrets, and may not
/// activate the binding or manufacture maturity evidence.
model IntegrationBinding {
  id                    String   @id
  tenantId              String
  organizationId        String
  providerId            String
  providerCapabilityId  String
  bindingKey            String
  capabilityCode        String
  transportType         String
  environment           String
  endpointReference     String?
  credentialReference   String?
  status                String   @default("PENDING_VERIFICATION")
  version               BigInt   @default(1)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  provider     Provider           @relation(fields: [providerId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "integration_binding_provider_fkey")
  capability   ProviderCapability @relation(fields: [providerCapabilityId, providerId, tenantId, organizationId], references: [id, providerId, tenantId, organizationId], onDelete: Restrict, map: "integration_binding_provider_capability_fkey")
  organization Organization       @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "integration_binding_organization_fkey")
  createdBy    UserOrg            @relation("IntegrationBindingCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "integration_binding_created_by_fkey")
  updatedBy    UserOrg            @relation("IntegrationBindingUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "integration_binding_updated_by_fkey")
  evidence     IntegrationCapabilityEvidence[]
  events       IntegrationBindingEvent[]

  @@unique([providerId, bindingKey], map: "integration_binding_provider_key")
  @@unique([id, tenantId, organizationId], map: "integration_binding_scope_identity_key")
  @@unique([id, providerId, tenantId, organizationId], map: "integration_binding_evidence_identity_key")
  @@index([tenantId, organizationId, status], map: "integration_binding_org_status_idx")
  @@index([providerCapabilityId, status], map: "integration_binding_capability_status_idx")
  @@map("integration_bindings")
}

/// Append-only, server-held facts used to derive the canonical 11-state
/// integration capability maturity. Application runtimes receive SELECT only.
model IntegrationCapabilityEvidence {
  id                   String   @id
  tenantId             String
  organizationId       String
  providerId           String
  integrationBindingId String
  maturity             String
  evidenceReference    String
  evidenceIssuer       String
  externalReceiptId    String?
  checkedAt             DateTime @db.Timestamptz(6)
  expiresAt             DateTime? @db.Timestamptz(6)
  version               BigInt   @default(1)
  recordedByAuthority  String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  binding IntegrationBinding @relation(fields: [integrationBindingId, providerId, tenantId, organizationId], references: [id, providerId, tenantId, organizationId], onDelete: Restrict, map: "integration_capability_evidence_binding_fkey")

  @@unique([integrationBindingId, maturity, version], map: "integration_capability_evidence_version_key")
  @@index([tenantId, organizationId, integrationBindingId, checkedAt(sort: Desc)], map: "integration_capability_evidence_lookup_idx")
  @@map("integration_capability_evidence")
}

/// Idempotent command receipt and tamper-evident chain for binding mutations.
model IntegrationBindingEvent {
  id                 String   @id
  tenantId           String
  organizationId     String
  providerId         String
  integrationBindingId String
  action             String
  resultStatus       String
  commandId          String
  idempotencyKey     String
  requestFingerprint String
  reason             String
  actorUserId        String
  actorRole          String
  actorMembershipId  String
  correlationId      String
  beforeState        Json?
  afterState         Json
  prevHash           String?
  hash               String
  auditEventId       String   @unique(map: "integration_binding_event_audit_key")
  outboxEntryId      String   @unique(map: "integration_binding_event_outbox_key")
  aggregateVersion   BigInt
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  binding      IntegrationBinding @relation(fields: [integrationBindingId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "integration_binding_event_binding_fkey")
  organization Organization       @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "integration_binding_event_organization_fkey")
  actor        UserOrg            @relation("IntegrationBindingEventActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "integration_binding_event_actor_fkey")

  @@unique([tenantId, organizationId, commandId], map: "integration_binding_event_command_key")
  @@unique([tenantId, organizationId, idempotencyKey], map: "integration_binding_event_idempotency_key")
  @@index([integrationBindingId, createdAt, id], map: "integration_binding_event_chain_idx")
  @@map("integration_binding_events")
}

/// Immutable version of one organization-owned commercial policy set. A row
/// may move DRAFT -> PUBLISHED -> RETIRED, but its definition and content hash
/// become database-protected as soon as it is published.
model CommercialRuleSet {
  id                    String    @id
  tenantId              String
  organizationId        String
  ruleSetKey            String
  version               BigInt
  stateVersion          BigInt    @default(1)
  status                String    @default("DRAFT")
  name                  String
  currency              String
  rules                 Json
  contentHash           String
  effectiveFrom         DateTime? @db.Timestamptz(6)
  effectiveTo           DateTime? @db.Timestamptz(6)
  publishedAt           DateTime? @db.Timestamptz(6)
  retiredAt             DateTime? @db.Timestamptz(6)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "commercial_rule_set_organization_fkey")
  createdBy    UserOrg             @relation("CommercialRuleSetCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "commercial_rule_set_created_by_fkey")
  updatedBy    UserOrg             @relation("CommercialRuleSetUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "commercial_rule_set_updated_by_fkey")
  decisions   CommercialDecision[]

  @@unique([tenantId, organizationId, ruleSetKey, version], map: "commercial_rule_set_version_key")
  @@unique([id, tenantId, organizationId], map: "commercial_rule_set_scope_identity_key")
  @@index([tenantId, organizationId, ruleSetKey, status], map: "commercial_rule_set_lookup_idx")
  @@map("commercial_rule_sets")
}

/// Immutable versioned bundle of exact CommercialRuleSet versions. Entries
/// contain ruleSet id, key, version and content hash, never a moving alias.
model CommercialRulePack {
  id                    String    @id
  tenantId              String
  organizationId        String
  rulePackKey           String
  version               BigInt
  stateVersion          BigInt    @default(1)
  status                String    @default("DRAFT")
  name                  String
  entries               Json
  contentHash           String
  effectiveFrom         DateTime? @db.Timestamptz(6)
  effectiveTo           DateTime? @db.Timestamptz(6)
  publishedAt           DateTime? @db.Timestamptz(6)
  retiredAt             DateTime? @db.Timestamptz(6)
  createdByMembershipId String
  updatedByMembershipId String
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "commercial_rule_pack_organization_fkey")
  createdBy    UserOrg             @relation("CommercialRulePackCreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "commercial_rule_pack_created_by_fkey")
  updatedBy    UserOrg             @relation("CommercialRulePackUpdatedBy", fields: [updatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "commercial_rule_pack_updated_by_fkey")
  decisions   CommercialDecision[]

  @@unique([tenantId, organizationId, rulePackKey, version], map: "commercial_rule_pack_version_key")
  @@unique([id, tenantId, organizationId], map: "commercial_rule_pack_scope_identity_key")
  @@index([tenantId, organizationId, rulePackKey, status], map: "commercial_rule_pack_lookup_idx")
  @@map("commercial_rule_packs")
}

/// Append-only evaluation evidence. It records the exact versioned authority,
/// canonical input/output and hashes without creating a financial obligation.
model CommercialDecision {
  id                  String   @id
  tenantId            String
  organizationId      String
  decisionKey         String
  ruleSetId           String
  ruleSetKey          String
  ruleSetVersion      BigInt
  ruleSetContentHash  String
  rulePackId          String?
  rulePackKey         String?
  rulePackVersion     BigInt?
  rulePackContentHash String?
  input               Json
  inputHash           String
  output              Json
  outputHash          String
  decisionStatus      String
  amountKopecks       BigInt?
  currency            String
  actorUserId         String
  actorMembershipId   String
  correlationId       String
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  ruleSet      CommercialRuleSet  @relation(fields: [ruleSetId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "commercial_decision_rule_set_fkey")
  rulePack     CommercialRulePack? @relation(fields: [rulePackId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "commercial_decision_rule_pack_fkey")
  organization Organization        @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "commercial_decision_organization_fkey")
  actor        UserOrg             @relation("CommercialDecisionActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "commercial_decision_actor_fkey")

  @@unique([tenantId, organizationId, decisionKey], map: "commercial_decision_key")
  @@index([tenantId, organizationId, ruleSetId, createdAt], map: "commercial_decision_rule_set_idx")
  @@map("commercial_decisions")
}

/// Idempotent command receipt and tamper-evident audit/outbox chain for rule
/// set and rule-pack lifecycle transitions.
model CommercialRuleEvent {
  id                 String   @id
  tenantId           String
  organizationId     String
  aggregateType      String
  aggregateId        String
  action             String
  resultStatus       String
  commandId          String
  idempotencyKey     String
  requestFingerprint String
  reason             String
  actorUserId        String
  actorRole          String
  actorMembershipId  String
  correlationId      String
  beforeState        Json?
  afterState         Json
  prevHash           String?
  hash               String
  auditEventId       String   @unique(map: "commercial_rule_event_audit_key")
  outboxEntryId      String   @unique(map: "commercial_rule_event_outbox_key")
  aggregateVersion   BigInt
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "commercial_rule_event_organization_fkey")
  actor        UserOrg      @relation("CommercialRuleEventActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "commercial_rule_event_actor_fkey")

  @@unique([tenantId, organizationId, commandId], map: "commercial_rule_event_command_key")
  @@unique([tenantId, organizationId, idempotencyKey], map: "commercial_rule_event_idempotency_key")
  @@index([tenantId, organizationId, aggregateType, aggregateId, createdAt, id], map: "commercial_rule_event_chain_idx")
  @@map("commercial_rule_events")
}

/// Server-held provider verification facts. W1-B grants application runtimes
/// SELECT only; no public or organization route can manufacture evidence.
model ProviderRegistryEvidence {
  id                   String   @id
  tenantId             String
  organizationId       String
  providerId           String
  providerCapabilityId String
  checkCode             String
  status                String
  source                String
  evidenceReference     String
  checkedAt             DateTime @db.Timestamptz(6)
  expiresAt             DateTime? @db.Timestamptz(6)
  version               BigInt   @default(1)
  recordedByAuthority   String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  capability ProviderCapability @relation(fields: [providerCapabilityId, providerId, tenantId, organizationId], references: [id, providerId, tenantId, organizationId], onDelete: Restrict, map: "provider_registry_evidence_capability_fkey")

  @@unique([providerCapabilityId, checkCode, version], map: "provider_registry_evidence_version_key")
  @@index([tenantId, providerId, checkCode, checkedAt(sort: Desc)], map: "provider_registry_evidence_lookup_idx")
  @@map("provider_registry_evidence")
}

/// Append-only idempotent command receipt and hash chain for the Provider
/// aggregate. The referenced audit and outbox rows commit in the same tx.
model ProviderRegistryEvent {
  id                 String   @id
  tenantId           String
  organizationId     String
  providerId         String
  entityType         String
  entityId           String
  category           String
  action             String
  resultStatus       String
  commandId          String
  idempotencyKey     String
  requestFingerprint String
  reason             String
  actorUserId        String
  actorRole          String
  actorMembershipId  String
  correlationId      String
  beforeState        Json?
  afterState         Json
  prevHash           String?
  hash               String
  auditEventId       String   @unique(map: "provider_registry_event_audit_key")
  outboxEntryId      String   @unique(map: "provider_registry_event_outbox_key")
  aggregateVersion   BigInt
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  provider     Provider     @relation(fields: [providerId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, map: "provider_registry_event_provider_fkey")
  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "provider_registry_event_organization_fkey")
  actor        UserOrg      @relation("ProviderRegistryEventActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "provider_registry_event_actor_fkey")

  @@unique([tenantId, organizationId, commandId], map: "provider_registry_event_command_key")
  @@unique([tenantId, organizationId, idempotencyKey], map: "provider_registry_event_idempotency_key")
  @@index([providerId, createdAt, id], map: "provider_registry_event_chain_idx")
  @@map("provider_registry_events")
}

/// Time-bounded delegation of a capability subset between two memberships of
/// the same organization. Legal signing authority is never delegable: the
/// database rejects `documents.sign` in `capabilities`.
model MembershipDelegation {
  id                    String    @id @default(cuid())
  tenantId              String
  organizationId        String
  fromMembershipId      String
  toMembershipId        String
  capabilities          String[]
  startsAt              DateTime  @db.Timestamptz(6)
  endsAt                DateTime  @db.Timestamptz(6)
  status                String    @default("ACTIVE")
  reason                String?
  createdByMembershipId String
  revokedAt             DateTime? @db.Timestamptz(6)
  version               BigInt    @default(0)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  fromMembership UserOrg      @relation("MembershipDelegationFrom", fields: [fromMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  toMembership   UserOrg      @relation("MembershipDelegationTo", fields: [toMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([organizationId, toMembershipId, status, endsAt])
  @@index([tenantId])
  @@map("membership_delegations")
}

/// What one membership may sign inside one organization. The platform never
/// holds a private key: this record names a certificate by fingerprint and
/// bounds its use by document type, amount, validity window and signing mode.
/// A delegated signer is invalid without a machine-readable power of attorney.
model SigningAuthority {
  id                     String    @id @default(cuid())
  tenantId               String
  organizationId         String
  membershipId           String
  authorityType          String
  mchdReference          String?
  validFrom              DateTime  @db.Timestamptz(6)
  validTo                DateTime  @db.Timestamptz(6)
  allowedDocumentTypes   String[]
  /// Kopecks. Null means the authority carries no monetary ceiling.
  amountLimitKopecks     BigInt?
  certificateFingerprint String
  allowedSigningModes    String[]
  status                 String    @default("ACTIVE")
  lastVerifiedAt         DateTime? @db.Timestamptz(6)
  grantedByMembershipId  String
  /// The independent approver behind a two-person grant. An ACTIVE authority
  /// must name one, and it may be neither the beneficiary nor the granter.
  secondApprovalMembershipId String?
  revokedAt              DateTime? @db.Timestamptz(6)
  version                BigInt    @default(0)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  membership     UserOrg      @relation("SigningAuthorityHolder", fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  secondApprover UserOrg?     @relation("SigningAuthoritySecondApprover", fields: [secondApprovalMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  signedVersions AccountingDocumentVersion[]

  @@index([organizationId, membershipId, status, validTo])
  @@index([tenantId])
  @@index([certificateFingerprint])
  @@map("signing_authorities")
}

/// A document the platform produces from its own data — a УПД, an acceptance
/// act, a payment order. Distinct from `DealDocument`, which is a file somebody
/// uploaded and attached to a deal: this one is generated, so it can be
/// regenerated, and every rendering of it records the source revisions it was
/// generated from. That snapshot is what makes staleness detectable at all.
model AccountingDocument {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  documentType   String
  /// Assigned when the document is issued. A null number means it has never
  /// left draft, and the unique index tolerates many of those precisely
  /// because null does not collide with null in PostgreSQL.
  documentNumber String?
  dealId         String?
  /// The other side of the document. Deliberately not a foreign key: a
  /// counterparty may be an organization that never registered here, and a
  /// document must still be issuable to it.
  counterpartyOrgId     String?
  status                String   @default("DRAFT")
  currentVersionNumber  Int      @default(0)
  createdByMembershipId String
  version               BigInt   @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy    UserOrg      @relation("AccountingDocumentAuthor", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  versions  AccountingDocumentVersion[]
  workTasks AccountingWorkTask[]

  @@unique([organizationId, documentType, documentNumber], map: "accounting_documents_number_identity_idx")
  @@index([organizationId, status, documentType])
  @@index([tenantId])
  @@index([dealId])
  @@map("accounting_documents")
}

/// One immutable rendering of an accounting document. A correction is a new
/// version, never an edit: the payload hash and the revision snapshot are what
/// a signature covers, so allowing either to move would let a signed document
/// come to mean something the signer never saw.
model AccountingDocumentVersion {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  documentId     String
  versionNumber  Int
  /// SHA-256 of the exact bytes this version renders to.
  payloadHash    String
  /// Revision of every source this version drew from, keyed by the document
  /// source names in accounting-document-staleness.policy.ts. A source absent
  /// from this object makes the version unverifiable rather than fresh.
  recordedRevisions Json
  /// Kopecks. Money is never a float, and the sign is left unconstrained
  /// because a correction may legitimately carry a negative total.
  totalKopecks                    BigInt?
  signedAt                        DateTime? @db.Timestamptz(6)
  signedByMembershipId            String?
  /// Which authority admitted the signature, kept so an audit can ask under
  /// what mandate a document was signed rather than only by whom.
  signingAuthorityId              String?
  signatureCertificateFingerprint String?
  /// When this version was handed to an external system, and what that system
  /// called what it took. Written once, from a receipt the far side issued;
  /// null means it has not been sent, never that sending failed.
  sentAt                          DateTime? @db.Timestamptz(6)
  transportCode                   String?
  externalReceiptId               String?
  externalReceiptIssuer           String?
  createdByMembershipId           String
  createdAt                       DateTime  @default(now()) @db.Timestamptz(6)

  document         AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy        UserOrg            @relation("AccountingDocumentVersionAuthor", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  signedBy         UserOrg?           @relation("AccountingDocumentVersionSigner", fields: [signedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  signingAuthority SigningAuthority?  @relation(fields: [signingAuthorityId], references: [id], onDelete: Restrict)
  advanceOffsets   AccountingAdvanceOffset[] @relation("AccountingAdvanceOffsetVersion")
  dealServices     AccountingDealService[]   @relation("AccountingDealServiceVersion")
  paymentAllocations AccountingPaymentAllocation[] @relation("AccountingPaymentAllocationVersion")

  @@unique([documentId, versionNumber])
  @@index([organizationId, documentId])
  @@index([tenantId])
  @@map("accounting_document_versions")
}

/// The sequence behind accounting document numbering, one row per
/// organization, document type and period.
///
/// Deliberately a row rather than a PostgreSQL sequence. A sequence keeps
/// counting through a rolled-back transaction, so an issue that failed halfway
/// leaves a hole where no document ever existed — and a hole in a numbered
/// sequence is exactly what an inspection reads as a removed document. A row
/// held under `SELECT … FOR UPDATE` for the length of the issuing transaction
/// rolls back with it.
model AccountingNumberCounter {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  documentType   String
  /// The calendar year for an annual sequence, 0 for a continuous one. Keeping
  /// it in the key means a new year starts a new row instead of resetting a
  /// shared one, so last year's sequence stays readable.
  periodYear     Int
  lastOrdinal    Int      @default(0)
  prefix         String   @default("")
  resetPolicy    String   @default("ANNUAL")
  padding        Int      @default(6)
  version        BigInt   @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([organizationId, documentType, periodYear])
  @@index([tenantId])
  @@map("accounting_number_counters")
}

/// A rule the platform applies, stored as a sequence of versions rather than
/// as a constant.
///
/// Documents outlive rules. A УПД issued in March under one rate list must
/// keep describing itself under that list when it is re-read in November, and
/// a platform that hardcodes the current rate silently rewrites its own
/// history the day the rate changes. Every accounting document version records
/// which rule version governed it; this is what that revision points at.
///
/// Deliberately not tenant-scoped. Tax law is not an organization's setting,
/// and a rule table a tenant could write is a rule table a tenant could
/// rewrite to justify a document after the fact — so the accounting principals
/// receive SELECT on it and nothing else.
model RegulatoryRuleVersion {
  id         String @id @default(cuid())
  /// What is being versioned, e.g. `VAT_RATES` or `UPD_FORMAT`.
  ruleKey    String
  versionTag String
  effectiveFrom DateTime  @db.Timestamptz(6)
  /// Exclusive. Null means still in force.
  effectiveTo   DateTime? @db.Timestamptz(6)
  status        String    @default("ACTIVE")
  /// Legal citation, so a document can say why it looks the way it does. A
  /// rule with no citation can only be trusted, never audited.
  source        String
  payload       Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([ruleKey, versionTag])
  @@index([ruleKey, effectiveFrom])
  @@map("regulatory_rule_versions")
}

/// An organization's declared tax status, versioned in time.
///
/// Versioned because a regime change in July must not retroactively change
/// what a document issued in March says about itself. Every accounting
/// document version records which profile version governed it; this is the
/// second revision source the staleness snapshot points at.
///
/// Unlike `regulatory_rule_versions`, this one is the organization's own
/// declaration and is therefore writable by its members — what it may not do
/// is change meaning after documents have cited it.
model OrganizationTaxProfile {
  id                 String  @id @default(cuid())
  tenantId           String
  organizationId     String
  versionTag         String
  taxRegime          String
  vatStatus          String
  /// Required exactly when the status is EXEMPT: the legal ground, in words.
  /// An exemption nobody can name is indistinguishable from not charging VAT
  /// for no reason.
  vatExemptionGround String?
  effectiveFrom      DateTime  @db.Timestamptz(6)
  /// Exclusive. Null means still current.
  effectiveTo        DateTime? @db.Timestamptz(6)
  createdByMembershipId String
  version            BigInt   @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy    UserOrg      @relation("OrganizationTaxProfileAuthor", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, versionTag])
  @@index([organizationId, effectiveFrom])
  @@index([tenantId])
  @@map("organization_tax_profiles")
}

/// A version of the commercial terms a document was generated under.
///
/// A УПД states a price, a delivery basis and a payment term, all of which come
/// from an agreement that can be amended. When it is amended the document does
/// not become wrong — it becomes a description of terms that no longer apply,
/// which is quieter and worse. Recording the exact version lets the platform
/// say which.
///
/// A signed version is immutable, like a signed document version and for the
/// same reason: the signature is evidence of what was agreed, and terms that
/// move underneath it are evidence of nothing. An amendment is a new version.
model ContractVersion {
  id                     String  @id @default(cuid())
  tenantId               String
  organizationId         String
  contractNumber         String
  versionNumber          Int
  status                 String  @default("DRAFT")
  /// SHA-256 of the exact terms this version fixes.
  termsHash              String
  terms                  Json
  /// The counterparty, deliberately not a foreign key: an agreement may be with
  /// an organization that never registered here.
  counterpartyOrgId      String?
  dealId                 String?
  effectiveFrom          DateTime  @db.Timestamptz(6)
  /// Exclusive. Null means still in force.
  effectiveTo            DateTime? @db.Timestamptz(6)
  signedAt               DateTime? @db.Timestamptz(6)
  signedByMembershipId   String?
  /// Null only for the first version; every amendment names what it replaces,
  /// so the chain back to what was originally agreed is always followable.
  supersedesVersionNumber Int?
  createdByMembershipId  String
  version                BigInt   @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy    UserOrg      @relation("ContractVersionAuthor", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  signedBy     UserOrg?     @relation("ContractVersionSigner", fields: [signedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, contractNumber, versionNumber])
  @@index([organizationId, contractNumber, effectiveFrom])
  @@index([tenantId])
  @@map("contract_versions")
}

/// One thing a human has to do, stated as the work rather than as a table row.
///
/// The distinction that makes this table worth having is `origin`. A MANUAL task
/// is somebody's note to themselves and closes when they say it is done. A
/// DERIVED task is the platform's report that some condition holds — a document
/// is unsigned, a transfer failed — and it cannot be closed by agreeing with it.
/// It closes when the condition it describes stops being true, and the database
/// checks that rather than taking the caller's word. A checkbox that dismisses
/// "the document is not signed" leaves the document unsigned and removes the
/// only sign that anybody would have noticed.
model AccountingWorkTask {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  taskType       String
  /// DERIVED or MANUAL. Not a note about where the row came from: it decides
  /// what closing the task requires.
  origin         String
  /// SYSTEM_VERIFIED, SYSTEM_REPORTED or HUMAN_JUDGEMENT — how a resolution is
  /// proven. A derived task is never HUMAN_JUDGEMENT; a CHECK refuses it.
  resolutionMode String
  /// Identity of the condition, so the same unsigned document does not grow a
  /// new task every time the deriver runs.
  derivationKey  String?
  /// The same value while the task is open, nulled by the guard when it closes.
  /// Uniqueness lives here rather than on derivationKey so a condition that
  /// recurs after being resolved raises a fresh task instead of colliding with
  /// the closed one. Null never collides with null in PostgreSQL, which is what
  /// makes this work without a partial index.
  openDerivationKey String?
  /// Lower sorts first. Deliberately not an enum: ordering is a product
  /// decision that moves, and a migration per reordering makes it move slowly.
  priority         Int    @default(100)
  title            String
  humanDescription String
  /// Which capability the responsible person must hold, from the resolver in
  /// membership-capability.resolver.ts. Not a role and not a job profile: the
  /// task names what must be permitted, and who holds that is resolved live.
  responsibleCapability String
  assignedMembershipId  String?
  dealId                String?
  shipmentId            String?
  documentId            String?
  integrationJobId      String?
  /// The period a task is about, when it is about one. Nullable because most
  /// tasks are about a document.
  periodId              String?
  /// The event that raised this, kept so a task traces back to the fact that
  /// produced it rather than only to its own creation.
  sourceEventId         String?
  blockingRuleId        String?
  status                String    @default("OPEN")
  deadlineAt            DateTime? @db.Timestamptz(6)
  /// Set by the database on close, never by the caller: a resolution time the
  /// client chooses is a resolution time the client can antedate.
  resolvedAt             DateTime? @db.Timestamptz(6)
  resolvedByMembershipId String?
  /// For SYSTEM_REPORTED closures: the event saying the condition cleared. It
  /// must differ from sourceEventId, because the event that raised the task
  /// cannot also be the news that it went away.
  resolutionEventId      String?
  /// Null for DERIVED tasks — nobody wrote them — and required for MANUAL ones.
  createdByMembershipId  String?
  version                BigInt   @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignedTo   UserOrg?            @relation("AccountingWorkTaskAssignee", fields: [assignedMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    UserOrg?            @relation("AccountingWorkTaskAuthor", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  resolvedBy   UserOrg?            @relation("AccountingWorkTaskResolver", fields: [resolvedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  document     AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  period       AccountingPeriod?   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([organizationId, openDerivationKey], map: "accounting_work_tasks_open_condition_idx")
  @@index([organizationId, status, priority])
  @@index([organizationId, assignedMembershipId, status])
  @@index([organizationId, responsibleCapability, status])
  @@index([tenantId])
  @@index([dealId])
  @@map("accounting_work_tasks")
}

/// The platform's statement that its own document set for a stretch of time is
/// settled — not an accounting ledger close.
///
/// «Прозрачная Цена» is not the books and does not replace 1С; what it can say
/// is that the documents it is authority for stopped moving. So a closed period
/// freezes exactly that: no new version of a document raised inside it, and no
/// signature on one. Everything else about the month is somebody else's system.
///
/// Closing is refused while derived work for the period is still open, because
/// a close declared over unfinished work is the report that gets believed and
/// then contradicted.
model AccountingPeriod {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  /// Inclusive.
  periodStart    DateTime @db.Timestamptz(6)
  /// Exclusive, so a successor beginning exactly where this ends is a clean
  /// handover rather than an overlap — the same convention the rule registry
  /// and the tax profiles use.
  periodEnd      DateTime @db.Timestamptz(6)
  /// OPEN, CLOSING or CLOSED. CLOSING exists so that the check for outstanding
  /// work happens against a period nobody is still adding to.
  status         String   @default("OPEN")
  closingStartedAt DateTime? @db.Timestamptz(6)
  /// Stamped by the database, never supplied: a close time the caller picks is
  /// a close time the caller can antedate.
  closedAt             DateTime? @db.Timestamptz(6)
  closedByMembershipId String?
  openedByMembershipId String
  version              BigInt   @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  openedBy     UserOrg      @relation("AccountingPeriodOpener", fields: [openedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workTasks    AccountingWorkTask[]
  closedBy     UserOrg?     @relation("AccountingPeriodCloser", fields: [closedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, periodStart])
  @@index([organizationId, status, periodStart])
  @@index([tenantId])
  @@map("accounting_periods")
}

/// Money received before the thing it pays for.
///
/// Recorded only against evidence that it arrived. An advance with no bank
/// operation behind it is a claim about money, and a claim about money offset
/// against a real invoice is how a balance stops matching a bank statement.
model AccountingAdvance {
  id                String @id @default(cuid())
  tenantId          String
  organizationId    String
  dealId            String
  counterpartyOrgId String
  /// Kopecks, never a Float: the whole contour holds money as an integer of the
  /// minor unit, and an advance is the one number two parties will compare.
  amountKopecks     BigInt
  currency          String @default("RUB")
  /// When the money arrived, which decides the period the advance falls in.
  receivedAt        DateTime @db.Timestamptz(6)
  /// The bank operation that proves it arrived. Required, and required to be
  /// confirmed — see the guard.
  bankOperationId   String
  recordedByMembershipId String
  version           BigInt   @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  recordedBy   UserOrg      @relation("AccountingAdvanceRecorder", fields: [recordedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  offsets      AccountingAdvanceOffset[]

  @@index([organizationId, dealId, receivedAt])
  @@index([tenantId])
  @@index([bankOperationId])
  @@map("accounting_advances")
}

/// One application of an advance against something owed.
///
/// Append-only. An offset that can be edited is a balance that can be made to
/// say anything after the fact, and the sum of these rows is exactly what makes
/// the remaining advance a fact rather than a stored opinion — there is no
/// cached balance column to drift from them.
model AccountingAdvanceOffset {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  advanceId      String
  /// Kopecks. Positive: a negative offset is a refund, which is a different
  /// event with its own evidence and is not spelled as a minus here.
  amountKopecks  BigInt
  appliedAt      DateTime @db.Timestamptz(6)
  /// What it was applied to, when that is a document version.
  documentVersionId String?
  reason         String
  /// Makes a retried command idempotent rather than doubly applied.
  idempotencyKey String @unique
  appliedByMembershipId String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  advance      AccountingAdvance          @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  organization Organization               @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  version      AccountingDocumentVersion? @relation("AccountingAdvanceOffsetVersion", fields: [documentVersionId], references: [id], onDelete: Restrict)
  appliedBy    UserOrg                    @relation("AccountingAdvanceOffsetActor", fields: [appliedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([advanceId])
  @@index([organizationId, appliedAt])
  @@index([tenantId])
  @@map("accounting_advance_offsets")
}

/// A service rendered on a deal: storage, drying, cleaning, transshipment,
/// weighing, loading.
///
/// The line is the priced fact, and every number in it is an integer. The
/// amount is not accepted from the caller: the database recomputes it from the
/// quantity and the rate, so a line whose total does not follow from its own
/// terms cannot exist. For storage the quantity is not free either — it has to
/// follow from the tonnage and the number of whole days in the window, which is
/// the arithmetic a storage charge is usually inflated through.
///
/// Nothing substantive is updatable. A wrong line is corrected by a reversal
/// line that names it, never by editing it: an accounting fact somebody can
/// rewrite after it has been approved is not a fact.
model AccountingDealService {
  id                String @id @default(cuid())
  tenantId          String
  organizationId    String
  dealId            String
  /// Who owes for it. Never the organization itself.
  counterpartyOrgId String
  /// STORAGE, DRYING, CLEANING, TRANSSHIPMENT, WEIGHING or LOADING.
  kind              String
  /// TON_DAY, TON or OPERATION. A function of the kind, stored so the API can
  /// answer with it and constrained so the two cannot drift apart.
  unit              String
  /// Quantity in thousandths of the unit. Thousandths rather than a Float
  /// because a rate multiplied by an approximation is an amount two parties
  /// will disagree about.
  quantityMilliUnits BigInt
  /// Thousandths of a ton. Required for TON_DAY and forbidden otherwise: it is
  /// what makes the ton-days checkable against the window.
  tonnageMilliTons  BigInt?
  /// The service window, for TON_DAY only. Inclusive start, exclusive end, the
  /// convention the periods and the rule registry already use.
  periodFrom        DateTime? @db.Timestamptz(6)
  periodTo          DateTime? @db.Timestamptz(6)
  /// Kopecks for one whole unit.
  rateKopecks       BigInt
  /// Kopecks. Derived, and checked against quantity × rate.
  amountKopecks     BigInt
  currency          String @default("RUB")
  /// When the service was rendered, which decides the period it falls in. For a
  /// storage window this is a point inside or at the end of it, not the window
  /// itself: a period is attributed to one month, and a window can straddle two.
  renderedAt        DateTime @db.Timestamptz(6)
  /// RENDERED, APPROVED or REJECTED.
  status            String @default("RENDERED")
  recordedByMembershipId String
  /// Stamped by the database on approval, never supplied.
  approvedAt        DateTime? @db.Timestamptz(6)
  /// The second person. Never the one who recorded the line.
  approvedByMembershipId String?
  /// The act this line was included in, once it was.
  documentVersionId String?
  /// The approved line this one reverses, for a correction. At most one
  /// reversal per line — the unique index says so, and PostgreSQL admits many
  /// NULLs, which is exactly the shape wanted.
  reversesServiceId String? @unique
  idempotencyKey    String @unique
  version           BigInt @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal         Deal                       @relation(fields: [dealId], references: [id], onDelete: Restrict)
  recordedBy   UserOrg                    @relation("AccountingDealServiceRecorder", fields: [recordedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvedBy   UserOrg?                   @relation("AccountingDealServiceApprover", fields: [approvedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  version_     AccountingDocumentVersion? @relation("AccountingDealServiceVersion", fields: [documentVersionId], references: [id], onDelete: Restrict)
  reverses     AccountingDealService?     @relation("AccountingDealServiceReversal", fields: [reversesServiceId], references: [id], onDelete: Restrict)
  reversedBy   AccountingDealService?     @relation("AccountingDealServiceReversal")
  paymentAllocations AccountingPaymentAllocation[] @relation("AccountingPaymentAllocationService")

  @@index([organizationId, dealId, renderedAt])
  @@index([organizationId, status, renderedAt])
  @@index([tenantId])
  @@map("accounting_deal_services")
}

/// Money that actually moved against a deal, and what it settles.
///
/// An advance is money that arrived before the thing it pays for; a payment is
/// money matched to obligations that already exist. Both cite a confirmed bank
/// operation, and one operation may back only one of them: counted twice, the
/// same transfer would pay the same debt twice on paper.
model AccountingPayment {
  id                String @id @default(cuid())
  tenantId          String
  organizationId    String
  dealId            String
  counterpartyOrgId String
  /// INCOMING or OUTGOING, from this organization's point of view.
  direction         String
  /// Kopecks, as the bank reported them.
  amountKopecks     BigInt
  currency          String @default("RUB")
  /// When the money moved, which decides the period it falls in.
  paidAt            DateTime @db.Timestamptz(6)
  /// The operation that proves it moved. Confirmed, for this deal, this amount.
  bankOperationId   String
  recordedByMembershipId String
  idempotencyKey    String @unique
  version           BigInt @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  recordedBy   UserOrg      @relation("AccountingPaymentRecorder", fields: [recordedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  allocations  AccountingPaymentAllocation[]

  /// One bank operation backs one payment in an organization's books.
  @@unique([organizationId, bankOperationId])
  @@index([organizationId, dealId, paidAt])
  @@index([tenantId])
  @@map("accounting_payments")
}

/// One part of a payment, applied to one obligation.
///
/// Append-only, like an advance offset and for the same reason: what is left
/// unallocated on a payment is the sum of these rows and nothing else, and a
/// stored remainder is a second source of truth for the same number.
model AccountingPaymentAllocation {
  id             String @id @default(cuid())
  tenantId       String
  organizationId String
  paymentId      String
  /// Exactly one of these two. A document version is an invoice or an act; a
  /// service line is a charge that has been approved by two people.
  documentVersionId String?
  dealServiceId     String?
  amountKopecks  BigInt
  allocatedAt    DateTime @db.Timestamptz(6)
  reason         String
  idempotencyKey String @unique
  allocatedByMembershipId String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  payment      AccountingPayment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  organization Organization               @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  version      AccountingDocumentVersion? @relation("AccountingPaymentAllocationVersion", fields: [documentVersionId], references: [id], onDelete: Restrict)
  service      AccountingDealService?     @relation("AccountingPaymentAllocationService", fields: [dealServiceId], references: [id], onDelete: Restrict)
  allocatedBy  UserOrg                    @relation("AccountingPaymentAllocationActor", fields: [allocatedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([paymentId])
  @@index([documentVersionId])
  @@index([dealServiceId])
  @@index([organizationId, allocatedAt])
  @@index([tenantId])
  @@map("accounting_payment_allocations")
}

/// A statement of mutual settlements with a counterparty, for one deal over one
/// window.
///
/// Every figure in it is computed by the server from the rows it summarises and
/// none of them is accepted from the caller. The closing balance is not stored
/// as an opinion either: a CHECK recomputes it from the other four, so a
/// statement whose bottom line does not follow from its own figures cannot
/// exist. Immutable once prepared — a reconciliation somebody can edit after
/// sending it is not a reconciliation.
model AccountingReconciliation {
  id                String @id @default(cuid())
  tenantId          String
  organizationId    String
  dealId            String
  counterpartyOrgId String
  /// Inclusive start, exclusive end, the convention the periods and the rule
  /// registry already carry.
  periodStart       DateTime @db.Timestamptz(6)
  periodEnd         DateTime @db.Timestamptz(6)
  currency          String @default("RUB")
  /// What was owed when the window opened. May be negative: the other party can
  /// be the one in credit.
  openingBalanceKopecks BigInt
  /// Approved service lines in the window that are charges.
  chargedKopecks        BigInt
  /// Approved reversals in the window. Kept as a figure of its own rather than
  /// netted into the charges: a correction that disappears into a smaller
  /// number is a correction the counterparty cannot see, and when it cancels a
  /// charge from an earlier window the netted figure would go negative and be
  /// clamped — which is money quietly leaving the statement.
  reversedKopecks       BigInt @default(0)
  /// Payment allocations in the window.
  paidKopecks           BigInt
  /// Advance offsets in the window.
  advanceAppliedKopecks BigInt
  /// Derived, and checked against the four above.
  closingBalanceKopecks BigInt
  /// SHA-256 over the figures, so a statement can be compared with the rows it
  /// claims to summarise rather than trusted.
  payloadHash       String
  /// PREPARED, AGREED or DISPUTED.
  status            String @default("PREPARED")
  preparedByMembershipId String
  /// Stamped by the database on the response, never supplied.
  respondedAt       DateTime? @db.Timestamptz(6)
  respondedByMembershipId String?
  responseNote      String?
  version           BigInt @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  preparedBy   UserOrg      @relation("AccountingReconciliationPreparer", fields: [preparedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  respondedBy  UserOrg?     @relation("AccountingReconciliationResponder", fields: [respondedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, dealId, counterpartyOrgId, periodStart, periodEnd])
  @@index([organizationId, dealId, periodStart])
  @@index([tenantId])
  @@map("accounting_reconciliations")
}

model UkepCertificate {
  id         String    @id @default(cuid())
  userId     String
  provider   String
  externalId String
  thumbprint String
  subject    String
  issuer     String
  validFrom  DateTime
  validUntil DateTime
  status     String    @default("VALID")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([thumbprint])
  @@map("ukep_certificates")
}

// ── Deals ─────────────────────────────────────────────────────────────────────

model Deal {
  id             String    @id
  lotId          String?
  sourceLotId    String?
  dealNumber     String?   @unique
  status         String    @default("DRAFT")
  tenantId       String?
  sellerOrgId    String
  buyerOrgId     String
  volumeTons     Float?
  pricePerTon    Float?
  totalRub       Float?
  totalKopecks   BigInt?
  pricePerTonDec Decimal?  @db.Decimal(20, 6)
  volumeTonsDec  Decimal?  @db.Decimal(20, 6)
  version        BigInt    @default(0)
  currency       String    @default("RUB")
  culture        String?
  cropClass      String?
  gost           String?
  region         String?
  incoterms      String?
  fundingChoice  String?
  owner          String?
  nextAction     String?
  slaAt          DateTime?
  signedAt       DateTime?
  closedAt       DateTime?
  sagaState      Json?
  sagaStep       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  meta           String?

  participants      DealParticipant[]
  shipments         Shipment[]
  documents         DealDocument[]
  payments          Payment[]
  labSamples        LabSample[]
  dealEvents        DealEvent[]
  acceptanceRecords AcceptanceRecord[]
  bankOperations    BankOperation[]
  accountingAdvances AccountingAdvance[]
  accountingDealServices AccountingDealService[]
