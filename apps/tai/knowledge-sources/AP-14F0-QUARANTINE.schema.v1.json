{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pachanin.example/schemas/tai-ap-14f0-quarantine.schema.v1.json",
  "title": "TAI AP-14F0 knowledge quarantine record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "recordedAt",
    "sourceId",
    "dataPlane",
    "artifactSha256",
    "state",
    "reasonCodes",
    "details",
    "retryable",
    "nextReviewAt",
    "tenantBindingHash",
    "evidenceReference",
    "remediation",
    "releaseDecision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "tai.ap14f0-quarantine.v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^quarantine_[a-z0-9]{16,80}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{4,160}$"
    },
    "dataPlane": {
      "type": "string",
      "enum": ["PUBLIC_OFFICIAL", "TENANT_LIVE", "CONTRACTED"]
    },
    "artifactSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "const": "QUARANTINED"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "RIGHTS_UNRESOLVED",
          "REUSE_FORBIDDEN",
          "PROVENANCE_INCOMPLETE",
          "HOST_NOT_PINNED",
          "DIGEST_MISMATCH",
          "SOURCE_STALE",
          "AUTHORITY_REVIEW_OVERDUE",
          "PERSONAL_OR_SECRET_DATA",
          "CABINET_OR_CREDENTIAL_MATERIAL",
          "TENANT_BOUNDARY_MISSING",
          "CROSS_TENANT_RISK",
          "PROMPT_INJECTION_OR_UNTRUSTED_INSTRUCTIONS"
        ]
      }
    },
    "details": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2000
    },
    "retryable": {
      "type": "boolean"
    },
    "nextReviewAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "tenantBindingHash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceReference": {
      "type": "string",
      "pattern": "^evidence-ref:[A-Za-z0-9._/-]{6,200}$"
    },
    "remediation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 500
      }
    },
    "releaseDecision": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/releaseDecision"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"dataPlane": {"enum": ["TENANT_LIVE", "CONTRACTED"]}},
        "required": ["dataPlane"]
      },
      "then": {
        "properties": {
          "tenantBindingHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  ],
  "$defs": {
    "releaseDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decidedAt",
        "decidedBySubjectHash",
        "mfaVerified",
        "justification",
        "replacementProvenanceRecordId",
        "auditEventId"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["HUMAN_RELEASED", "HUMAN_REJECTED"]
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decidedBySubjectHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mfaVerified": {
          "type": "boolean",
          "const": true
        },
        "justification": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "replacementProvenanceRecordId": {
          "type": ["string", "null"],
          "pattern": "^prov_[a-z0-9]{16,64}$"
        },
        "auditEventId": {
          "type": "string",
          "pattern": "^audit_[a-z0-9]{12,80}$"
        }
      }
    }
  }
}
