# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global pnpm@10.2.1

COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile
RUN pnpm --filter @pc/api build
RUN test -f /workspace/apps/api/dist/apps/api/src/main.js
RUN test -f /workspace/apps/api/dist/apps/api/src/role-eligibility-worker.js
RUN pnpm --filter @pc/api --prod deploy --legacy /prod/api

# Отказ по умолчанию на копилефт в поставляемом дереве. Гейт читает то, что
# физически уезжает в образ, а не то, что объявляет рабочее пространство:
# SBOM включает dev, optional и чужие архитектуры, юридическое значение
# имеют только эти файлы. Решения по обязательствам записаны с основанием
# в docs/ip/third-party-license-overrides.json и ссылаются на этот гейт.
RUN node scripts/ip/verify-shipped-licenses.mjs /prod/api

# TypeScript emits the API below the workspace-relative path because the API
# imports shared workspace packages. pnpm deploy carries dependencies only, so
# copy that exact output and materialize Prisma's generated side effects.
RUN rm -rf /prod/api/src /prod/api/test /prod/api/prisma /prod/api/dist \
  && cp -R /workspace/apps/api/dist /prod/api/dist \
  && mkdir -p /prod/api/config/eligibility \
  && cp /workspace/config/eligibility/farmer-okved-v1.json /prod/api/config/eligibility/farmer-okved-v1.json
RUN test -f /prod/api/dist/apps/api/src/main.js \
  && test -f /prod/api/dist/apps/api/src/role-eligibility-worker.js \
  && test -f /prod/api/config/eligibility/farmer-okved-v1.json
RUN node scripts/release/materialize-prisma-client.mjs /workspace/apps/api /prod/api
RUN cd /prod/api \
  && node -e "const {PrismaClient}=require('@prisma/client'); if(typeof PrismaClient!=='function') throw new Error('PrismaClient export is unavailable')"

# Distroless Debian 13 still ships OpenSSL 3.5.6 at the current upstream tag.
# Overlay the exact Debian security build while retaining the distroless/nonroot
# runtime. Package control records are copied with the payload so Trivy/SBOM
# inventory reflects the files that are actually installed.
FROM debian:trixie-slim AS openssl-security-patch
ARG OPENSSL_SECURITY_VERSION=3.5.7-1~deb13u2
WORKDIR /tmp/openssl-security
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates; \
  apt-get download \
    "libssl3t64=${OPENSSL_SECURITY_VERSION}" \
    "openssl-provider-legacy=${OPENSSL_SECURITY_VERSION}"; \
  mkdir -p /openssl-root/var/lib/dpkg/status.d; \
  for deb in *.deb; do \
    package_name="$(dpkg-deb --field "${deb}" Package)"; \
    dpkg --ctrl-tarfile "${deb}" | tar -Oxf - ./control > "/openssl-root/var/lib/dpkg/status.d/${package_name}"; \
    dpkg --extract "${deb}" /openssl-root; \
  done; \
  grep -Fx "Version: ${OPENSSL_SECURITY_VERSION}" /openssl-root/var/lib/dpkg/status.d/libssl3t64; \
  grep -Fx "Version: ${OPENSSL_SECURITY_VERSION}" /openssl-root/var/lib/dpkg/status.d/openssl-provider-legacy; \
  find /openssl-root/usr/lib -name 'libssl.so.3' -type f -print -quit | grep -q .; \
  find /openssl-root/usr/lib -name 'libcrypto.so.3' -type f -print -quit | grep -q .; \
  rm -rf /var/lib/apt/lists/*

FROM gcr.io/distroless/nodejs24-debian13:nonroot AS runtime
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG APP_VERSION=3.0.0
LABEL org.opencontainers.image.title="Prozrachnaya Cena API" \
      org.opencontainers.image.description="Canonical transaction API for the autonomous industrial contour" \
      org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.version=$APP_VERSION
ENV NODE_ENV=production
ENV PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /app
COPY --from=openssl-security-patch /openssl-root/ /
COPY --from=build --chown=nonroot:nonroot /prod/api/ ./

EXPOSE 3001
USER nonroot
CMD ["dist/apps/api/src/main.js"]
