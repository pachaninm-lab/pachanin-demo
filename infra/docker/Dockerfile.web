# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim AS build
ARG GIT_COMMIT=unknown
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global pnpm@10.2.1

COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile
RUN COMMIT_REF="$GIT_COMMIT" BRANCH=main node scripts/write-deploy-evidence.mjs
RUN pnpm --filter @pc/web build
RUN rm -rf /workspace/apps/web/.next/cache
RUN pnpm --filter @pc/web --prod deploy --legacy /prod/web

# Оптимизатор картинок выключен в next.config.js, а его нативная зависимость
# больше не едет пользователю. Замерено до этой правки: sharp и его платформенные
# сборки давали 36 МБ, из них @img/sharp-libvips-linux-x64 и
# @img/sharp-libvips-linuxmusl-x64 — LGPL-3.0-or-later, при нуле обращений к
# next/image во всём приложении. `require('sharp')` в Next ленивый и лежит
# только в dist/server/image-optimizer.js, поэтому удаление не влияет на старт.
RUN set -eux; \
  rm -rf /prod/web/node_modules/sharp; \
  find /prod/web/node_modules/.pnpm -maxdepth 1 \( -name 'sharp@*' -o -name '@img+*' \) -exec rm -rf {} +; \
  find /prod/web/node_modules -name '@img' -exec rm -rf {} + 2>/dev/null || true; \
  find /prod/web/node_modules -xtype l -name 'sharp' -delete; \
  test -z "$(find /prod/web/node_modules -name 'sharp' -print -quit)"; \
  test -z "$(find /prod/web/node_modules -name '@img' -print -quit)"; \
  test -d /prod/web/node_modules/next

# Отказ по умолчанию на копилефт в поставляемом дереве. Гейт читает то, что
# физически уезжает в образ, а не то, что объявляет рабочее пространство:
# SBOM включает dev, optional и чужие архитектуры, юридическое значение имеют
# только эти файлы. Принятые обязательства перечислены с основаниями.
RUN node scripts/ip/verify-shipped-licenses.mjs /prod/web

FROM debian:trixie-slim AS ocr-runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    imagemagick \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    tesseract-ocr-eng \
    tesseract-ocr-rus \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  mkdir -p /ocr-root/usr/bin /ocr-root/opt/ocr/lib /ocr-root/tmp; \
  chmod 1777 /ocr-root/tmp; \
  for binary in /usr/bin/tesseract /usr/bin/pdftoppm /usr/bin/pdftotext; do \
    test -x "$binary"; \
    cp -L --parents "$binary" /ocr-root; \
  done; \
  if test -x /usr/bin/convert; then \
    cp -L /usr/bin/convert /ocr-root/usr/bin/convert; \
    imagemagick_binary=/usr/bin/convert; \
  elif test -x /usr/bin/magick; then \
    cp -L /usr/bin/magick /ocr-root/usr/bin/convert; \
    imagemagick_binary=/usr/bin/magick; \
  else \
    echo 'ImageMagick executable is missing' >&2; \
    exit 31; \
  fi; \
  for directory in /etc/ImageMagick-* /usr/share/ImageMagick-* /usr/share/tesseract-ocr; do \
    if test -e "$directory"; then \
      cp -a --parents "$directory" /ocr-root; \
    fi; \
  done; \
  find /usr/lib \( -path '*/ImageMagick-*/*' -o -path '*/libheif/*' \) \( -type f -o -type l \) -print0 \
    | xargs -0 -r cp -L --parents -t /ocr-root; \
  { \
    printf '%s\n' /usr/bin/tesseract /usr/bin/pdftoppm /usr/bin/pdftotext "$imagemagick_binary"; \
    find /usr/lib \( -path '*/ImageMagick-*/*' -o -path '*/libheif/*' \) -type f -name '*.so*' -print; \
  } \
    | while IFS= read -r elf; do ldd "$elf" 2>/dev/null || true; done \
    | awk '$3 ~ /^\// { print $3 } $1 ~ /^\// { print $1 }' \
    | sort -u \
    | while IFS= read -r library; do \
        cp -L "$library" "/ocr-root/opt/ocr/lib/$(basename "$library")"; \
      done; \
  rm -f /ocr-root/opt/ocr/lib/libssl.so.3 /ocr-root/opt/ocr/lib/libcrypto.so.3; \
  test -x /ocr-root/usr/bin/tesseract; \
  test -x /ocr-root/usr/bin/pdftoppm; \
  test -x /ocr-root/usr/bin/pdftotext; \
  test -x /ocr-root/usr/bin/convert; \
  test -f /ocr-root/usr/share/tesseract-ocr/5/tessdata/eng.traineddata; \
  test -f /ocr-root/usr/share/tesseract-ocr/5/tessdata/rus.traineddata; \
  test -f /ocr-root/usr/share/tesseract-ocr/5/tessdata/chi_sim.traineddata

# Distroless Debian 13 still ships OpenSSL 3.5.6 at the current upstream tag.
# Overlay the exact Debian security build while retaining the distroless/nonroot
# runtime. Package control records are copied with the payload so Trivy/SBOM
# inventory reflects the files that are actually installed.
FROM debian:trixie-slim AS openssl-security-patch
ARG OPENSSL_SECURITY_VERSION=3.5.7-1~deb13u2
WORKDIR /tmp/openssl-security
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates; \
  apt-get download \
    "libssl3t64=${OPENSSL_SECURITY_VERSION}" \
    "openssl-provider-legacy=${OPENSSL_SECURITY_VERSION}"; \
  mkdir -p /openssl-root/var/lib/dpkg/status.d; \
  for deb in *.deb; do \
    package_name="$(dpkg-deb --field "${deb}" Package)"; \
    dpkg --ctrl-tarfile "${deb}" | tar -Oxf - ./control > "/openssl-root/var/lib/dpkg/status.d/${package_name}"; \
    dpkg --extract "${deb}" /openssl-root; \
  done; \
  grep -Fx "Version: ${OPENSSL_SECURITY_VERSION}" /openssl-root/var/lib/dpkg/status.d/libssl3t64; \
  grep -Fx "Version: ${OPENSSL_SECURITY_VERSION}" /openssl-root/var/lib/dpkg/status.d/openssl-provider-legacy; \
  find /openssl-root/usr/lib -name 'libssl.so.3' -type f -print -quit | grep -q .; \
  find /openssl-root/usr/lib -name 'libcrypto.so.3' -type f -print -quit | grep -q .; \
  rm -rf /var/lib/apt/lists/*

FROM gcr.io/distroless/nodejs24-debian13:nonroot AS runtime
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG APP_VERSION=3.0.0
LABEL org.opencontainers.image.title="Prozrachnaya Cena web" \
      org.opencontainers.image.description="Server-rendered transaction workspace and public product experience" \
      org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.version=$APP_VERSION
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV APP_REVISION=$GIT_COMMIT
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
ENV MAGICK_TEMPORARY_PATH=/tmp
ENV LD_LIBRARY_PATH=/opt/ocr/lib
WORKDIR /app

COPY --from=ocr-runtime /ocr-root/ /
COPY --from=openssl-security-patch /openssl-root/ /
RUN ["/usr/bin/tesseract", "--version"]
RUN ["/usr/bin/pdftoppm", "-v"]
RUN ["/usr/bin/convert", "-version"]
COPY --from=build --chown=nonroot:nonroot /prod/web/ ./
COPY --from=build --chown=nonroot:nonroot /workspace/apps/web/.next ./.next
COPY --from=build --chown=nonroot:nonroot /workspace/apps/web/public ./public

EXPOSE 3000
USER nonroot
HEALTHCHECK --interval=30s --timeout=7s --start-period=45s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3000/api/health/ready',{signal:AbortSignal.timeout(5000)}).then((response)=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node_modules/next/dist/bin/next", "start", "-p", "3000"]

