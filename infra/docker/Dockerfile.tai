# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm AS build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /build

COPY apps/tai/pyproject.toml ./pyproject.toml
COPY apps/tai/tai ./tai

RUN python -m venv /opt/tai-venv \
  && /opt/tai-venv/bin/pip install --upgrade pip setuptools wheel \
  && /opt/tai-venv/bin/pip install . \
  && /opt/tai-venv/bin/python -c "import tai.production_entrypoint"

FROM python:3.12-slim-bookworm AS runtime
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG APP_VERSION=0.1.0
LABEL org.opencontainers.image.title="TAI Agro OS" \
      org.opencontainers.image.description="Local-first agricultural intelligence runtime for Prozrachnaya Cena" \
      org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.version=$APP_VERSION

ENV PATH=/opt/tai-venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TAI_RUNTIME_MODE=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 65532 tai \
  && useradd --system --uid 65532 --gid 65532 --home-dir /nonexistent --shell /usr/sbin/nologin tai

WORKDIR /app
COPY --from=build --chown=65532:65532 /opt/tai-venv /opt/tai-venv

EXPOSE 8080
USER 65532:65532

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=3).read()"]

CMD ["uvicorn", "tai.production_entrypoint:app", "--host", "0.0.0.0", "--port", "8080", "--no-server-header", "--no-proxy-headers"]
