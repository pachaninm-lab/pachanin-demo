# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm AS build
ENV VIRTUAL_ENV=/opt/tai-venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
WORKDIR /src/apps/tai

RUN python -m venv "$VIRTUAL_ENV" \
  && pip install --no-cache-dir --upgrade pip setuptools wheel

COPY apps/tai/pyproject.toml ./pyproject.toml
COPY apps/tai/tai ./tai
RUN pip install --no-cache-dir . \
  && python -c "from tai.production_entrypoint import app; assert app is not None"

FROM python:3.12-slim-bookworm AS runtime
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG APP_VERSION=0.1.0
LABEL org.opencontainers.image.title="Transparent Agro Intelligence" \
      org.opencontainers.image.description="Rootless TAI production orchestration runtime" \
      org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.version=$APP_VERSION

ENV VIRTUAL_ENV=/opt/tai-venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOME=/tmp
ENV TMPDIR=/tmp

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 10001 tai \
  && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent tai

COPY --from=build --chown=tai:tai /opt/tai-venv /opt/tai-venv
WORKDIR /app
USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/opt/tai-venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=3).read()"]

CMD ["/opt/tai-venv/bin/uvicorn", "tai.production_entrypoint:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-server-header"]
